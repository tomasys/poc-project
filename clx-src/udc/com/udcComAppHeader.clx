<?xml version="1.1" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-1bfcceb2" version="1.0.5186">
  <head std:sid="head-c44bf217">
    <screen std:sid="screen-13742b8b" id="default" name="default" width="1640px" height="984px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800" active="true"/>
    <screen std:sid="screen-5f8930cf" id="tablet" name="tablet" width="1024px" height="767px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-9bccce5a" id="mobile" name="mobile" width="0px" height="767px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <cl:model std:sid="model-f47cf99e"/>
    <cl:appspec dev-description="앱 헤더">
      <cl:property name="title" type="string" default="타이틀을 입력하세요" bindable="true" std:desc="[String] 앱타이틀"/>
      <cl:property name="searchBoxId" type="string" default="grpSearch" bindable="true" std:desc="[String] 조회조건 그룹 ID (default: grpSearch)&#xD;&#xA;&#xD;&#xA;콤마(,)로 연결하여 여러 개의 조회조건 그룹을 작성 할 수 있으며, 작성되어 있는 그룹ID 를 통해 조회조건 초기화 기능이 수행됩니다.&#xD;&#xA;&#xD;&#xA;&lt;조회조건 초기화 기능>&#xD;&#xA;1. 조회영역내 조회조건 컨트롤의 selection-change, value-change시 작업영역(groupBoxIds 속성에 설정한 그룹ID) disable 처리&#xD;&#xA;2. 조회영역 내에 인풋 컨트롤(인풋박스,넘버에디터) 의 사용자 속성에 autoKeydownSearch = &quot;Y&quot; 지정시 keydown 이벤트 등록(조회버튼 클릭)"/>
      <cl:property name="groupBoxIds" type="string" default="grpData" bindable="true" std:desc="[String] 작업영역 그룹/탭 ID (default: grpData)&#xD;&#xA;&#xD;&#xA;콤마(,)로 연결하여 여러 개의 작업영역 컨트롤 ID를 작성 할 수 있습니다.&#xD;&#xA;비활성 처리는 isGrpDataDisable=true 일 경우에만 동작합니다."/>
      <cl:property name="dsProcessId" type="string" default="dsProcess" bindable="true" std:desc="[String] 프로세스 데이터셋 ID (default : dsProcess)"/>
      <cl:property name="isViewPocProcess" type="boolean" default="false" std:desc="[Boolean] 최초 로드시 프로세스 표시 여부(default : true)"/>
      <cl:property name="isExpandAllPocProcess" type="boolean" default="true" std:desc="[Boolean] 최초 로드시 프로세스 내 목록 전체 오픈 여부(default : false)"/>
      <cl:property name="isFillContainer" type="boolean" default="true" std:desc="[Boolean] 컨테이너에 가득채우기 여부(프로세스 내 스크롤 생성)"/>
      <cl:property name="isGrpDataDisable" type="boolean" default="false" bindable="true" std:desc="[Boolean] 앱로드시 작업영역(groupBoxIds) 비활성화 여부 (default: false), 조회영역에 구성된 조회 버튼 클릭시 자동 활성화 처리"/>
      <cl:property name="isGridInit" type="boolean" default="true" std:desc="[Boolean] 앱로드시 그리드 초기화 여부 (default: true)&#xD;&#xA;&#xD;&#xA;화면에 배치되어 있는 모든 그리드를 대상으로 초기화 작업을 진행합니다.&#xD;&#xA;&#xD;&#xA;&lt;그리드 초기화 기능>&#xD;&#xA;1. 상태 컬럼 스타일 설정&#xD;&#xA;2. 인덱스 컬럼 text 및 css 지정&#xD;&#xA;3. 소트 컬럼 자동지정&#xD;&#xA;4. 그리드, 프리폼 PK컬럼 enable 설정&#xD;&#xA;5. 그리드의 마지막 작업행을 찾기위한 이벤트 추가&#xD;&#xA;6. 그리드 타이틀(udcComGridTitle) 의 조회 건수 업데이트&#xD;&#xA;7. 그리드 selection-dispose 이벤트 추가 (행추가 후 삭제로 인해 선택행이 없는 경우 이전 행 자동 선택)"/>
      <cl:property name="ignoreGridIds" type="string" std:desc="[String] 그리드 초기화 시, 제외할 그리드 ID&#xD;&#xA;&#xD;&#xA;콤마(,)로 연결하여 여러 개의 그리드를 작성 할 수 있으며, 작성한 그리드 ID는 앱 로드시 그리드 초기화에서 제외됩니다."/>
      <cl:property name="isFreeformInit" type="boolean" default="false" std:desc="[Boolean] 앱로드시 프리폼 초기화 여부 (default: false)&#xD;&#xA;&#xD;&#xA;화면에 배치되어 있는 모든 프리폼을 대상으로 초기화 작업을 진행합니다.&#xD;&#xA;&#xD;&#xA;&lt;프리폼 초기화 기능>&#xD;&#xA;1. 데이터 존재 여부에 따른 프리폼 비활성화 처리&#xD;&#xA;2. 프리폼 내부 넘버에디터 컨트롤의 포맷에 따른 css, max 속성 처리"/>
      <cl:property name="ignoreFreeFormIds" type="string" std:desc="[String] 프리폼 초기화 시, 제외할 프리폼 ID&#xD;&#xA;&#xD;&#xA;콤마(,)로 연결하여 여러 개의 프리폼을 작성 할 수 있으며, 작성한 프리폼 ID는 앱 로드시 프리폼 초기화에서 제외됩니다."/>
      <cl:property name="isTreeInit" type="boolean" default="false" std:desc="[Boolean] 앱로드시 트리 초기화 여부 (default: false)&#xD;&#xA;&#xD;&#xA;화면에 배치되어 있는 모든 트리를 대상으로 초기화 작업을 진행합니다.&#xD;&#xA;&#xD;&#xA;&lt;트리 초기화 기능>&#xD;&#xA;1. 트리의 선택행 컨텍스트 바인딩 한 프리폼 PK컬럼 enable 설정&#xD;&#xA;2. 트리의 마지막 작업행을 찾기위한 이벤트 추가"/>
      <cl:property name="ignoreTreeIds" type="string" std:desc="[String] 트리 초기화 시, 제외할 트리 ID&#xD;&#xA;&#xD;&#xA;콤마(,)로 연결하여 여러 개의 트리를 작성 할 수 있으며, 작성한 트리 ID는 앱 로드시 트리 초기화에서 제외됩니다."/>
      <cl:property name="exportPdfGrpIds" type="string" std:desc="pdf로 export할 그룹 ID, pdf다운로드시 컨텐츠가 너무길어 빈페이지로 나올 경우 그룹을 나누어 사용 ex)grp1,grp2"/>
      <cl:property name="showPDF" type="boolean" default="true" std:desc="[Boolean] PDF 파일 Export 버튼 보이기 여부"/>
      <cl:property name="asisImgSrc" type="resource" std:desc="팝업에 보여줄 이미지 경로를 설정합니다.&#xD;&#xA;설정시에만 팝업을 띄우는 버튼을 표시합니다."/>
    </cl:appspec>
  </head>
  <body std:sid="body-264c4ad9" style="top:0px; left:0px; width:900px; height:28px;" class="page-tit-wrap">
    <cl:listener std:sid="listener-e2975343" name="load" handler="onBodyLoad"/>
    <cl:listener std:sid="listener-f0c29aac" name="screen-change" handler="onBodyScreenChange"/>
    <cl:attribute name="mobile-column-count" value="1"/>
    <cl:group std:sid="group-7e58aaf9">
      <cl:attribute name="needs-auto-height" value="true"/>
      <cl:formdata std:sid="f-data-51beda29" row="0" col="0"/>
      <cl:output std:sid="output-202fc71c" id="optTit" class="tit">
        <cl:listener std:sid="listener-b5fbb49d" name="dblclick" handler="onOutputDblclick"/>
        <cl:apppropbind property="value" category="PROPERTY" app-property="title"/>
        <cl:flowlayoutdata std:sid="f-data-d9958977" width="245px" height="100%" autosize="both"/>
      </cl:output>
      <cl:checkbox std:sid="c-box-2f2d4e9e" id="cbxFav" class="fav text-center" value="" text="">
        <cl:listener std:sid="listener-4016b35a" name="value-change" handler="onCheckBoxValueChange"/>
        <cl:flowlayoutdata std:sid="f-data-abf1e969" width="24px" height="24px" autosize="none"/>
      </cl:checkbox>
      <cl:button std:sid="button-02ab4650" id="btnPdf" class="icon btn-pdf" tooltip="화면 PDF 다운로드" icon="0">
        <cl:listener std:sid="listener-4962474d" name="click" handler="onBtnPdfClick"/>
        <cl:apppropbind property="visible" category="PROPERTY" app-property="showPDF"/>
        <cl:flowlayoutdata std:sid="f-data-b90a80ec" width="24px" height="24px"/>
        <cl:iconstyle class="icon"/>
      </cl:button>
      <cl:button std:sid="button-3c9d38c4" id="btnClx" class="icon btn-clx" tooltip="CLX 바로가기" icon="0">
        <cl:listener std:sid="listener-1f78f835" name="click" handler="onBtnClxClick"/>
        <cl:flowlayoutdata std:sid="f-data-c9374751" width="24px" height="24px"/>
      </cl:button>
      <cl:button std:sid="button-077618d8" id="btnProcess" class="icon btn-scenario" tooltip="평가 시나리오" icon="0">
        <cl:listener std:sid="listener-db6be50b" name="click" handler="onBtnProcessClick"/>
        <cl:flowlayoutdata std:sid="f-data-c63b559e" width="24px" height="24px"/>
      </cl:button>
      <cl:button std:sid="button-9ec04471" id="btnImgPop" class="icon" tooltip="AS-IS 이미지 확인" icon="0">
        <cl:listener std:sid="listener-3e76d926" name="click" handler="onBtnImgPopClick"/>
        <cl:expbind property="visible" category="PROPERTY" expression="@asisImgSrc != null &amp;&amp; @asisImgSrc != &quot;&quot;"/>
        <cl:flowlayoutdata std:sid="f-data-9e2f0871" width="24px" height="24px" autosize="none"/>
        <cl:iconstyle class="icon ico-question font-size-xxlarge"/>
      </cl:button>
      <cl:flowlayout std:sid="f-layout-80582431" scrollable="false" hspacing="4" vspacing="0" valign="middle" linewrap="false"/>
    </cl:group>
    <cl:formlayout std:sid="f-layout-ce0da0fb" scrollable="false" hspace="0px" vspace="0px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
      <cl:rows length="28" unit="PIXEL" autoSizing="true"/>
      <cl:columns length="1" unit="FRACTION" shadetype="NONE" shadecolor="transparent"/>
    </cl:formlayout>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>