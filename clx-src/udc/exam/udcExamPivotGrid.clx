    <cl:appspec title="피벗 그리드">
      <cl:property name="dataset" type="control" std:desc="피벗 타겟 데이터 셋"/>
      <cl:property name="pivotHelperMaxHeight" type="number" default="260" std:desc="피벗 도우미의 최대 사이즈"/>
      <cl:property name="suppressedCellType" type="enumeration" default="split" std:desc="병합 스타일(splie,merged)">
        <cl:available-value>split</cl:available-value>
        <cl:available-value>merged</cl:available-value>
      </cl:property>
      <cl:property name="rows" type="string" std:desc="행 필드 ex) &quot;row1&quot;,&quot;row2&quot;.."/>
      <cl:property name="columns" type="string" std:desc="컬럼 필드 ex) &quot;col1&quot;,&quot;col2&quot;.."/>
      <cl:property name="values" type="string" std:desc="값 필드 ex) &quot;val1&quot;,&quot;val2&quot;"/>
      <cl:property name="isfooter" type="boolean" default="false" std:desc="푸터합계 여부"/>
      <cl:property name="isSubTotal" type="boolean" default="false" std:desc="소계 여부"/>
      <cl:property name="cbxAtRn" type="boolean" default="true" std:desc="자동실행 여부"/>
      <cl:property name="pivotHelperVisible" type="boolean" default="true" std:desc="피벗도우미 visible 여부"/>
      <cl:event name="execute" type="cpr.events.CMouseEvent" std:desc="피벗을 실행했을 때 발생하는 이벤트"/>
      <cl:event name="toggle" type="cpr.events.CMouseEvent" std:desc="피벗도우미에서 토글시 발생하는 이벤트"/>
      <cl:event name="reset" type="cpr.events.CMouseEvent" std:desc="피벗을 초기화했을 때 발생하는 이벤트"/>
    </cl:appspec>
  </head>
