  <head std:sid="head-b0063bfb">
    <std:metadata>
      <std:property key="template-file" value="templates/일반화면/0.프레임/V_프레임_샘플링.clx"/>
    </std:metadata>
    <screen std:sid="screen-c1fbbac4" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-994997be" id="EXB-DIV" name="EXB-DIV" width="600px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
