  <head std:sid="head-2c71609e">
    <std:metadata>
      <std:property key="template-file" value="templates/일반화면/0.프레임/V_프레임_샘플링.clx"/>
    </std:metadata>
    <screen std:sid="screen-3cd9a137" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-ab2c5c88" id="EXB-DIV" name="EXB-DIV" width="600px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-41c87535" id="EXB-POP[1024]" name="EXB-POP[1024]" width="1024px" height="576px"/>
    <screen std:sid="screen-f1269b6c" id="EXB-POP[800]" name="EXB-POP[800]" width="800px" height="480px"/>
    <screen std:sid="screen-c36dbaa6" id="EXB-PART" name="EXB-PART" width="0px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-d883aab2" id="EXB-POP[480]" name="EXB-POP[480]" width="480px" height="320px"/>
    <cl:model std:sid="model-0af7521e"/>
    <cl:appspec>
      <cl:property name="autoStart" type="boolean" default="true" bindable="true" std:desc="[Boolean] 화면 로드시 바로 로드할지 여부(true: load하자마자 바로 리포트 연동, false: start() API 호출 시 리포트 연동)"/>
      <cl:property name="filePath" type="string" bindable="true" std:desc="[String] clip/clipreport5/crf 에 위치한 파일명칭"/>
      <cl:property name="datamapProp" type="control" std:desc="[DataMap] 파라미터 전달한 데이터맵 객체"/>
      <cl:property name="defaultRatio" type="enumeration" bindable="true" std:desc="[Enum] 페이지 비율(default : pc는 100%, mobile은 pageWidth)">
        <cl:available-value>75%</cl:available-value>
        <cl:available-value>100%</cl:available-value>
        <cl:available-value>150%</cl:available-value>
        <cl:available-value>200%</cl:available-value>
        <cl:available-value>pageWidth</cl:available-value>
        <cl:available-value>wholePage</cl:available-value>
      </cl:property>
      <cl:property name="customSaveButton" type="string" default="false,false,false,false" bindable="true" std:desc="[String] 커스텀 저장 버튼 사용 여부 true/false (hwp, xls, pdf, doc 순)"/>
      <cl:property name="useAccessibility" type="boolean" default="true" bindable="true" std:desc="[Boolean] 웹접근성 준수여부 (준수할 경우 HTML4로 구성)"/>
      <cl:property name="headerButtonSize" type="number" bindable="true" std:desc="[Number] 헤더의 버튼 사이즈 (px 사이즈로 적용)"/>
      <cl:property name="setSaveButtonVisible" type="enumeration" default="visible" bindable="true" std:desc="[Enum] 저장버튼 visible 여부">
        <cl:available-value>visible</cl:available-value>
        <cl:available-value>hidden</cl:available-value>
      </cl:property>
      <cl:property name="setPrintButtonVisible" type="enumeration" default="visible" bindable="true" std:desc="[Enum] 프린트버튼 visible 여부 ">
        <cl:available-value>visible</cl:available-value>
        <cl:available-value>hidden</cl:available-value>
      </cl:property>
      <cl:property name="setRatioComboVisible" type="enumeration" default="visible" bindable="true" std:desc="[Enum] 화면 비율 콤보박스 visible 여부">
        <cl:available-value>visible</cl:available-value>
        <cl:available-value>hidden</cl:available-value>
      </cl:property>
      <cl:property name="setInfoButtonVisible" type="enumeration" default="visible" bindable="true" std:desc="[Enum] info버튼 visible 여부">
        <cl:available-value>visible</cl:available-value>
        <cl:available-value>hidden</cl:available-value>
      </cl:property>
      <cl:property name="setCloseButtonVisible" type="enumeration" default="hidden" bindable="true" std:desc="[Enum] 닫기버튼 visible 여부">
        <cl:available-value>visible</cl:available-value>
        <cl:available-value>hidden</cl:available-value>
      </cl:property>
      <cl:property name="setPageBoxVisible" type="enumeration" default="visible" bindable="true" std:desc="[Enum] 페이지표시 box visible 여부">
        <cl:available-value>visible</cl:available-value>
        <cl:available-value>hidden</cl:available-value>
      </cl:property>
      <cl:property name="setRatioComboNameVisible" type="string" bindable="true" std:desc="[String] 화면 비율 콤보박스의 아이템 visible 여부 (value,isValue 형식)"/>
      <cl:property name="setThumbnailUse" type="boolean" default="false" bindable="true" std:desc="[Boolean] 썸네일 뷰 표시 여부"/>
      <cl:property name="setVisibleMenu" type="boolean" default="true" bindable="true" std:desc="[Boolean] 메뉴 툴바 표시 여부"/>
      <cl:event name="report-load" type="cpr.events.CAppEvent"/>
    </cl:appspec>
  </head>
  <body std:sid="body-251adb99" style="top:0px; left:0px; width:300px; height:300px;">
