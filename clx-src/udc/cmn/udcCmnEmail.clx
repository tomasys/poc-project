      <cl:item std:sid="t-item-42a270a2" label="hanmail.net" value="hanmail.net"/>
      <cl:item std:sid="t-item-43db7ab2" label="gmail.com" value="gmail.com"/>
    </cl:combobox>
    <cl:formlayout std:sid="f-layout-acd2762c" scrollable="false" hspace="4px" vspace="4px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
      <cl:rows length="1" unit="FRACTION"/>
      <cl:columns length="1" unit="FRACTION"/>
