    </cl:output>
    <cl:inputbox std:sid="i-box-19d5d221" id="ipbDomain">
      <cl:apppropbind property="value" app-property="domain"/>
      <cl:formdata std:sid="f-data-90d86007" row="0" col="2"/>
    </cl:inputbox>
    <cl:combobox std:sid="c-box-67e3f71e" id="cmbDomain">
      <cl:listener std:sid="listener-6d561466" name="selection-change" handler="onComboBoxSelectionChange"/>
      <cl:formdata std:sid="f-data-f4898562" row="0" col="3"/>
