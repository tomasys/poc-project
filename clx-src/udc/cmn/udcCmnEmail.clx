    <cl:model std:sid="model-cebfa7a3"/>
    <cl:appspec title="이메일">
      <cl:property name="id" type="string" bindable="true"/>
      <cl:property name="domain" type="string" bindable="true"/>
      <cl:property name="visibleDomainSelecter" type="enumeration" default="combo" bindable="true" std:desc="도메인 선택 콤보박스 보임 여부">
        <cl:available-value>input</cl:available-value>
        <cl:available-value>combo</cl:available-value>
        <cl:available-value>both</cl:available-value>
      </cl:property>
    </cl:appspec>
  </head>
  <body std:sid="body-b04209c3" style="top:0px; left:0px; width:300px; height:28px;">
    <cl:listener std:sid="listener-148ff32b" name="property-change" handler="onBodyPropertyChange"/>
    <cl:listener std:sid="listener-c4a1f6c7" name="load" handler="onBodyLoad"/>
    <cl:inputbox std:sid="i-box-7d9d5ed2" id="ipbId">
      <cl:apppropbind property="value" app-property="id"/>
      <cl:formdata std:sid="f-data-6fee15da" row="0" col="0"/>
