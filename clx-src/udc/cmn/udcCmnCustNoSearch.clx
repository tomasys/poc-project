<?xml version="1.0" encoding="UTF-8"?>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:cl="http://tomatosystem.co.kr/cleopatra" xmlns:std="http://tomatosystem.co.kr/cleopatra/studio" std:sid="html-3ebb14f6" version="1.0.4221">
  <head std:sid="head-2b8cc41c">
    <screen std:sid="screen-39cb60f9" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="695" active="true"/>
    <screen std:sid="screen-c7e93d56" id="EXB-DIV" name="EXB-DIV" width="600px" height="768px" useCustomWidth="false" useCustomHeight="false" customHeight="600" customWidth="800"/>
    <screen std:sid="screen-6a5419d2" id="EXB-PART" name="EXB-PART" width="0px" height="768px" useCustomWidth="true" useCustomHeight="false" customHeight="600" customWidth="375"/>
    <cl:model std:sid="model-f3897586"/>
    <cl:appspec dev-description="고객번호검색 팝업을 호출하는 컴포넌트 입니다." title="고객번호검색 컴포넌트">
      <cl:property name="korNm" type="string" bindable="true" std:desc="고객명"/>
      <cl:property name="jumin" type="number" bindable="true" std:desc="주민등록번호"/>
      <cl:property name="custNo" type="string" bindable="true" std:desc="고객번호"/>
      <cl:property name="engNm" type="string" bindable="true" std:desc="고객영문명"/>
      <cl:property name="job" type="string" bindable="true" std:desc="직업"/>
      <cl:property name="age" type="string" bindable="true" std:desc="나이"/>
      <cl:property name="nation" type="string" bindable="true" std:desc="국적"/>
      <cl:property name="birth" type="string" bindable="true" std:desc="생년월일"/>
      <cl:property name="drvYn" type="string" bindable="true" std:desc="운전여부"/>
      <cl:event name="customer-value-change" type="cpr.events.CValueChangeEvent" std:desc="[고객검색 컴포넌트]에서 고객정보 변경 후 발생하는 이벤트"/>
    </cl:appspec>
  </head>
  <body std:sid="body-5cda2741" style="top:0px; left:0px; width:130px; height:28px;" class="cust-search">
    <cl:inputbox comment="고객번호" std:sid="i-box-4518e705" id="ipbCustNo" fieldLabel="고객번호" inputfilter="[0-9]">
      <cl:listener std:sid="listener-e1eea1f0" name="keyup" handler="onIpbCustomerNmKeyup"/>
      <cl:listener std:sid="listener-2e698409" name="clear" handler="onIpbCustNoClear"/>
      <cl:listener std:sid="listener-83da5fa1" name="value-change" handler="onIpbCustNoValueChange"/>
      <cl:listener std:sid="listener-dc295b1a" name="keydown" handler="onIpbCustNoKeydown"/>
      <cl:attribute name="required" value="Y"/>
      <cl:apppropbind property="value" category="PROPERTY" app-property="custNo"/>
      <cl:formdata std:sid="f-data-2b2ccb80" row="0" col="0"/>
    </cl:inputbox>
    <cl:button comment="고객검색버튼" std:sid="button-fb2f2bf9" id="btnSearch" style="padding-left:0px; padding-right:0px;" class="btn-search-secondary icon border" fieldLabel="고객검색" value="" icon="0">
      <cl:listener std:sid="listener-de9055f7" name="click" handler="onBtnSearchClick"/>
      <cl:formdata std:sid="f-data-377bb955" row="0" col="1"/>
    </cl:button>
    <cl:formlayout std:sid="f-layout-eb2817a3">
      <cl:rows length="1" unit="FRACTION"/>
      <cl:columns length="100" unit="PIXEL"/>
      <cl:columns length="28" unit="PIXEL" shadetype="NONE" shadecolor="transparent"/>
    </cl:formlayout>
  </body>
  <std:studiosetting>
    <std:hruler/>
    <std:vruler/>
  </std:studiosetting>
</html>