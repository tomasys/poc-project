      <cl:property name="embId" type="string" default="embapp1" std:desc="[String] 워크플로우 실행 시 화면을 표시할 타겟 임베디드앱 ID"/>
      <cl:event name="proccess-click" type="cpr.events.CUIEvent"/>
    </cl:appspec>
  </head>
