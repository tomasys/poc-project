  <body std:sid="body-848a6554" style="top:0px; left:0px; width:600px; height:500px;" class="card">
    <cl:listener std:sid="listener-38ebe442" name="load" handler="onBodyLoad"/>
    <cl:output std:sid="output-1f1f4501" id="opt5" value="개인">
      <cl:formdata std:sid="f-data-0adf8892" row="0" col="0"/>
    </cl:output>
    <cl:output std:sid="output-6c97bb63" id="opt8" datatype="number" format="s#,##0" displayexp="abs(Number(value)) > 99999 ? Number(value)>0 ? &quot;+&quot;+floor(Number(value)/10000)+&quot;만&quot; : floor(Number(value)/10000)+&quot;만&quot; : text">
      <cl:expbind property="class" category="CLASS" expression="PRSN_NTBY_QTY > 0 ? &quot;text-wts-red&quot; : &quot;text-wts-blue&quot;"/>
      <cl:relativebind property="value" columnname="PRSN_NTBY_QTY"/>
      <cl:selectioncontext selectionProvider="grdInvest"/>
      <cl:formdata std:sid="f-data-d35bf5b8" row="0" col="1"/>
    </cl:output>
    <cl:slider std:sid="slider-a5d665b8" id="sldPrsn" readonly="true" value="50,50" range="true">
      <cl:expbind property="class" category="CLASS" expression="PRSN_NTBY_QTY > 0 ? &quot;slide-invest up&quot; : &quot;slide-invest&quot;"/>
