      <cl:expbind property="class" category="CLASS" expression="FRGN_NTBY_QTY > 0 ? &quot;text-wts-red&quot; : &quot;text-wts-blue&quot;"/>
      <cl:relativebind property="value" columnname="FRGN_NTBY_QTY"/>
