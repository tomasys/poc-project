        </cl:output>
        <cl:output std:sid="output-4beb428b" id="optCTRT2" datatype="number" format="#,##0" displayexp="out_val4_32+&quot;원(&quot;+out_val4_33+&quot;%)&quot;">
          <cl:expbind property="class" category="CLASS" expression="out_val4_32 > 0 ? &quot;text-wts-red&quot; : &quot;text-wts-blue&quot;"/>
          <cl:datarowcontext datacontrolid="dsDayStockOut"/>
          <cl:flowlayoutdata std:sid="f-data-ec6fed11" width="328px" height="32px" autosize="width"/>
        </cl:output>
