          <cl:datacolumn comment="원화평가금액" std:sid="d-column-73479c49" name="WON_EVL_AMT" datatype="number"/>
          <cl:datacolumn comment="원화평가손익금액" std:sid="d-column-992fea6f" name="WON_EVL_PFLS_AMT" datatype="number"/>
          <cl:datacolumn comment="외화평가금액" std:sid="d-column-f975dd28" name="FRCR_EVL_AMT" datatype="number"/>
          <cl:datacolumn comment="외화평가손익금액2" std:sid="d-column-46dc3114" info="" name="FRCR_EVL_PFLS_AMT2" datatype="number"/>
          <cl:datacolumn comment="손익률" std:sid="d-column-7706ba58" name="PFLS_RT" datatype="number"/>
          <cl:datacolumn comment="주식현재가" std:sid="d-column-9df479f0" name="STK_PV" datatype="number"/>
          <cl:datacolumn comment="해외주식현재가" std:sid="d-column-dfb71bac" name="OVRS_STK_PV"/>
          <cl:datacolumn comment="해외거래소코드" std:sid="d-column-99683cb0" name="OVRS_EXCG_COD"/>
