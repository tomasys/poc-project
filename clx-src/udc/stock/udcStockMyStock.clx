          <cl:datacolumn comment="금일고객매입단가" std:sid="d-column-5ad90458" name="TDAY_CUST_PCHS_UNPR" datatype="number"/>
          <cl:datacolumn comment="외화주문단가" std:sid="d-column-7169b741" info="" name="FRCR_ORD_UNPR" datatype="number"/>
          <cl:datacolumn comment="원화체결기준매수금액" std:sid="d-column-75ee8f00" name="WON_CNCS_STDR_BUY_AMT" datatype="number"/>
