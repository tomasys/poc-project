          <cl:datacolumn comment="매입단가" std:sid="d-column-5a359c78" name="ORD_UNPR" datatype="expression" expression="DMS_OVRS_USE_SCD == &quot;1&quot; ? TDAY_CUST_PCHS_UNPR : FRCR_ORD_UNPR"/>
