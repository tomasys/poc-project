          <cl:datacolumn comment="국내해외사용구분코드" std:sid="d-column-96241c53" name="DMS_OVRS_USE_SCD" defaultvalue=""/>
          <cl:datacolumn comment="조회구분코드" std:sid="d-column-49da6b7f" name="INQ_SCD" defaultvalue="1"/>
          <cl:datacolumn comment="신용잔고조회구분코드" std:sid="d-column-06924069" name="CRDT_BLN_INQ_SCD"/>
          <cl:datacolumn comment="개별계좌번호" std:sid="d-column-900e2609" name="IACN"/>
          <cl:datacolumn comment="고객번호" std:sid="d-column-c7668cd2" name="CUNO"/>
          <cl:datacolumn comment="수수료포함여부" std:sid="d-column-9c0c9144" name="FEE_INCL_YN"/>
          <cl:datacolumn comment="잔고조회구분" std:sid="d-column-83abe5ac" name="BLN_INQ_SE"/>
          <cl:datacolumn comment="주식시세구분코드" std:sid="d-column-ad0db92e" name="STK_QTTN_SCD"/>
        </cl:datacolumnlist>
      </cl:datamap>
      <cl:submission comment="보유종목 TR3300Q5" std:sid="submission-3ffcadd4" id="subMyStock" method="get" action="app/sce/A15/data/myStock.json" mediatype="application/x-www-form-urlencoded;simple">
        <cl:requestdata dataid="dmMyStockIn"/>
        <cl:responsedata dataid="dsMyStock" alias="outRec2" isadd="true"/>
      </cl:submission>
    </cl:model>
    <cl:appspec title="보유중인 주식"/>
