          <cl:datarow>
            <cl:datavalue columnname="GUBUN">체크리스트</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">모바일 테스트\n- Android, iOS (각 OS별 HDMI 젠더 확인)</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">사전 준비</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">체크리스트</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">PDF 장표 확인</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">사전 준비</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">체크리스트</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">PoC 환경 설치\n- Eclipse 설치 (전문 플러그인, 화면 자동 설계서 jar 설치 확인)</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">환경 구성</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">체크리스트</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">시연 환경 Port 정보\n- PoC 메인 : 8080\n- 서브 : 8081</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">환경 구성</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">체크리스트</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">eXBuilder6 Trial License 적용 (1달)</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">환경 구성</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">체크리스트</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">[소스 압축 및 난독화 사용] 해제</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">프로젝트 설정</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">체크리스트</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">[appcache=true] 적용</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">프로젝트 설정</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">체크리스트</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">Eclipse 실행 메모리 조정</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">현장 확인</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">체크리스트</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">빔 프로젝터 해상도 점검</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">현장 확인</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">체크리스트</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">시연PC 프로그램 설치 확인\n- 엑셀 설치 여부 확인\n- IE 설치 여부 확인\n- eXDevice 관련 : A14 폴더 내 VBS 파일 확인\n\t\t\t   eXDevice 설치\n- SystemInformer 설치</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">현장 확인</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">체크리스트</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">대용량 성능 확인 시나리오 사전 테스트\n(최초 로딩시에만 시간이 오래 걸림)</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">현장 확인</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">체크리스트</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">파일 업로드 시연 관련\n- 테스트 업로드 파일 모두 삭제 (C:\\uploadfiles\\cmn)</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">현장 확인</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">체크리스트</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">eXCFrame-thirdparty - Report 샘플 동작 확인\n- Crownix, Ubi 서비스 실행 필요</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">현장 확인</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">자동 완성 기능 (Ctrl+Alt+L)</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">스크립트</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">자동 들여쓰기 (Ctrl+Shift+F)</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">스크립트</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">자동 포맷팅 (Ctrl+Alt+R)</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">스크립트</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">API 도움말 편의성 (Ctrl+Space)\n- 사용 통계에 대한 정렬 확인</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">스크립트</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">컨텐트 어시스트 (Ctrl+space)\n- 데이터 셋 ID, 컬럼명 찾기\n- 기본 API, 공통 기능, 다국어, AppID 찾기 (Ctrl + click 기능도 함께 확인)\n- 빠른 팔레트 뷰 (UI 템플릿, UDC 미리보기)</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">스크립트</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">파일명 리팩토링\n- 파일명 변경 시, 스크립트 일괄 변경 확인\n  (UDC 타입, 다이얼로그 open 시 작성한 AppID)</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">스크립트</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">이벤트 바로가기\n- 디자인 탭 / 스크립트 탭 양방향 확인</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">디자인 편집기</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">[바인딩 피드백 표시] 기능 확인</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">디자인 편집기</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">그리드 데이터 셋 바인딩\n-  그리드 생성 옵션창 확인</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">디자인 편집기</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">Template 기능\n- 화면 템플릿 / UI 템플릿</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">디자인 편집기</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">UDC 출판 기능 (속성, 이벤트)\n- 차트 UDC 의 속성 바인딩으로 확인</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">디자인 편집기</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">[표시순으로 자식 정렬] 기능 확인</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">디자인 편집기</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">브라우저 미리보기 기능\n- 브라우저 설정 옵션\n- 로컬 미리보기 / 실행 중인 서버 미리보기</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">디자인 편집기</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="GUBUN">개발편의성 시연 목록</cl:datavalue>
            <cl:datavalue columnname="CHK_LIST">이미지로 내보내기 (Ctrl+Alt+E)</cl:datavalue>
            <cl:datavalue columnname="CLASSIFICATION">디자인 편집기</cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
