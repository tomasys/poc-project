        <cl:group std:sid="group-31e6c879" class="css-framework" clipcontent="false">
          <cl:verticaldata std:sid="v-data-8ab9bfe8" width="400px" height="525px" autosize="height"/>
          <cl:htmlsnippet std:sid="htmlsnippet-352d90e4" value="&lt;div class=&quot;bg-white rounded-lg shadow-md w-80 p-4&quot;>&#xD;&#xA;    &lt;img src=&quot;./theme/img/pages/main/logo.png&quot; alt=&quot;Card Image&quot; class=&quot;rounded-t-lg w-full h-40 object-contain&quot;>&#xD;&#xA;    &lt;div class=&quot;p-4&quot;>&#xD;&#xA;      &lt;h2 class=&quot;text-xl font-bold text-gray-800&quot;>Card Title&lt;/h2>&#xD;&#xA;      &lt;p class=&quot;text-gray-600 mt-2&quot;>&#xD;&#xA;        This is a simple card description. You can use this card for any purpose like displaying content.&#xD;&#xA;      &lt;/p>&#xD;&#xA;      &lt;button class=&quot;mt-4 w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded&quot;>&#xD;&#xA;        Learn More&#xD;&#xA;      &lt;/button>&#xD;&#xA;    &lt;/div>&#xD;&#xA;  &lt;/div>">
            <cl:flowlayoutdata std:sid="f-data-da6d4099" width="320px" height="370px" autosize="both"/>
          </cl:htmlsnippet>
          <cl:htmlsnippet std:sid="htmlsnippet-c811dc6b" value="&lt;div class=&quot;bg-white rounded-lg shadow-md p-8 w-96&quot;>&#xA;  &lt;h2 class=&quot;text-2xl font-bold text-gray-800 text-center mb-6&quot;>Login&lt;/h2>&#xA;  &lt;form action=&quot;#&quot; method=&quot;POST&quot;>&#xA;    &lt;div class=&quot;mb-4&quot;>&#xA;      &lt;label for=&quot;email&quot; class=&quot;block text-gray-600 mb-2&quot;>Email Address&lt;/label>&#xA;      &lt;input type=&quot;email&quot; id=&quot;email&quot; class=&quot;w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500&quot; placeholder=&quot;you@example.com&quot;>&#xA;    &lt;/div>&#xA;    &lt;div class=&quot;mb-6&quot;>&#xA;      &lt;label for=&quot;password&quot; class=&quot;block text-gray-600 mb-2&quot;>Password&lt;/label>&#xA;      &lt;input type=&quot;password&quot; id=&quot;password&quot; class=&quot;w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500&quot; placeholder=&quot;********&quot;>&#xA;    &lt;/div>&#xA;    &lt;button type=&quot;submit&quot; class=&quot;w-full bg-blue-500 text-white py-2 px-4 rounded-lg hover:bg-blue-600&quot;>Login&lt;/button>&#xA;  &lt;/form>&#xA;  &lt;p class=&quot;mt-4 text-sm text-gray-600 text-center&quot;>&#xA;    Don't have an account? &lt;a href=&quot;#&quot; class=&quot;text-blue-500 hover:underline&quot;>Sign up&lt;/a>&#xA;  &lt;/p>&#xA;&lt;/div>">
            <cl:flowlayoutdata std:sid="f-data-3c0917be" width="320px" height="370px" autosize="both"/>
          </cl:htmlsnippet>
          <cl:htmlsnippet std:sid="htmlsnippet-e88fbf49" value="&lt;div class=&quot;bg-white border border-gray-200 rounded-lg shadow-md w-80 p-6 text-center&quot;>&#xA;  &lt;h3 class=&quot;text-2xl font-bold text-gray-800&quot;>Basic Plan&lt;/h3>&#xA;  &lt;p class=&quot;text-gray-600 mt-2&quot;>Perfect for individuals&lt;/p>&#xA;  &lt;div class=&quot;text-4xl font-extrabold text-blue-600 mt-4&quot;>$19&lt;span class=&quot;text-lg text-gray-600&quot;>/month&lt;/span>&lt;/div>&#xA;  &lt;ul class=&quot;text-gray-600 text-sm mt-6 space-y-2&quot;>&#xA;    &lt;li>✔ 10 Projects&lt;/li>&#xA;    &lt;li>✔ 5 Team Members&lt;/li>&#xA;    &lt;li>✔ 24/7 Support&lt;/li>&#xA;  &lt;/ul>&#xA;  &lt;button class=&quot;mt-6 w-full bg-blue-500 text-white py-2 px-4 rounded-lg hover:bg-blue-600&quot;>&#xA;    Get Started&#xA;  &lt;/button>&#xA;&lt;/div>">
            <cl:flowlayoutdata std:sid="f-data-19c40089" width="320px" height="370px" autosize="both"/>
          </cl:htmlsnippet>
          <cl:htmlsnippet std:sid="htmlsnippet-7a30f7cc" value="&lt;div class=&quot;flex items-center bg-blue-100 text-blue-800 p-4 rounded-lg shadow-md w-full max-w-lg&quot;>&#xA;  &lt;svg class=&quot;w-6 h-6 mr-3&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; viewBox=&quot;0 0 24 24&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;>&#xA;    &lt;path stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot; stroke-width=&quot;2&quot; d=&quot;M13 16h-1v-4h-1m1-4h.01M21 12c0 4.418-3.582 8-8 8s-8-3.582-8-8 3.582-8 8-8 8 3.582 8 8z&quot;>&lt;/path>&#xA;  &lt;/svg>&#xA;  &lt;p class=&quot;text-sm&quot;>&#xA;    This is an important notification. Please take action.&#xA;  &lt;/p>&#xA;&lt;/div>">
            <cl:flowlayoutdata std:sid="f-data-eee2c3af" width="320px" height="370px" autosize="both"/>
          </cl:htmlsnippet>
          <cl:flowlayout std:sid="f-layout-aeb58a53" scrollable="false" hspacing="8" vspacing="8"/>
