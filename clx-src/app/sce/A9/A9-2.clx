          <cl:datacolumn std:sid="d-column-b4004ac2" name="SUB_CODE"/>
          <cl:datacolumn comment="" std:sid="d-column-8d6dc077" name="TARGET_CTRL"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">목적</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">버튼, 입력창, 모달창 등의 커스터마이징이 자유로운지 확인</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">검증 조건</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">동일한 컨트롤에 다양한 스타일과 속성을 적용할 수 있는지 확인한다.</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">측정</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">각 컨트롤에 각각 다른 클래스를 적용하여 다른 스타일을 적용한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">버튼과 아웃풋에 적용되어 있는 다양한 스타일 클래스를 확인한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">스타일 클래스</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">버튼,아웃풋</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">grp1</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">팝업 속성을 설정한 뒤, [Layer Popup 호출] 버튼을 누른다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">Layer Popup 호출</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">속성</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">grp4</cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec title="다양한 컴포넌트 스타일"/>
  </head>
