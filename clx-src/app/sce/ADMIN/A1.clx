          <cl:datacolumn std:sid="d-column-18380ef4" name="TOP_MENU_ID"/>
          <cl:datacolumn comment="대상 페이지" std:sid="d-column-b7879d44" name="CALL_PAGE"/>
          <cl:datacolumn std:sid="d-column-9bdc2fe6" name="PGM_ID"/>
          <cl:datacolumn std:sid="d-column-4c100870" name="ICON"/>
          <cl:datacolumn std:sid="d-column-a2bd6f9f" name="MENU_KEY"/>
          <cl:datacolumn std:sid="d-column-1d8b7278" name="MOBILE_YN"/>
          <cl:datacolumn std:sid="d-column-7bb4293e" name="DESC"/>
          <cl:datacolumn std:sid="d-column-f1e3e1d7" name="CLASS"/>
          <cl:datacolumn std:sid="d-column-a5f7493c" name="MENU_DESC" datatype="expression" expression="&quot;[&quot; + MENU_NM + &quot;] &quot; + DESC&#xD;&#xA;"/>
          <cl:datacolumn std:sid="d-column-e7bfcd7b" name="MENU_LOWERCASE" datatype="expression" expression="doLowerCase(MENU_NM)"/>
          <cl:datacolumn std:sid="d-column-48c5ffc5" name="DESC_LOWERCASE" datatype="expression" expression="doLowerCase(DESC)"/>
          <cl:datacolumn std:sid="d-column-e9a2adee" name="MENU_LVL" datatype="number"/>
          <cl:datacolumn std:sid="d-column-833dbc36" name="MENU_FAV"/>
          <cl:datacolumn std:sid="d-column-f4a106b6" name="TAG"/>
          <cl:datacolumn std:sid="d-column-ce41a5d0" name="TAG_LOWERCASE" datatype="expression" expression="doLowerCase(TAG)"/>
          <cl:datacolumn std:sid="d-column-c02635f6" name="REFLECT_YN"/>
          <cl:datacolumn comment="일반사용자 메뉴 접근여부" std:sid="d-column-26a049e3" name="USR_ACCESS_YN"/>
          <cl:datacolumn comment="일반사용자 트랜잭션 허용여부" std:sid="d-column-9e70a736" name="USR_TRANS_YN"/>
          <cl:datacolumn std:sid="d-column-84fd9390" name="SORT_COL" datatype="number"/>
        </cl:datacolumnlist>
        <cl:datarowlist/>
      </cl:dataset>
      <cl:dataset comment="접속 현황" std:sid="d-set-8026aae3" id="dsConnectStatus">
        <cl:datacolumnlist>
          <cl:datacolumn comment="사용자ID" std:sid="d-column-e1c8db0f" name="userId" datatype="string"/>
          <cl:datacolumn comment="사용자명" std:sid="d-column-146f22ea" name="userNm"/>
          <cl:datacolumn comment="OS정보" std:sid="d-column-83a408ee" name="os"/>
          <cl:datacolumn comment="접속IP" std:sid="d-column-92a84c44" name="ip"/>
          <cl:datacolumn comment="접속기기" std:sid="d-column-5bdbc820" name="browser"/>
          <cl:datacolumn comment="강제로그아웃" std:sid="d-column-9c476ba2" name="isLogout" datatype="string"/>
          <cl:datacolumn comment="접속일자" std:sid="d-column-6b470a11" name="date"/>
          <cl:datacolumn comment="사용자타입" std:sid="d-column-6eef9048" name="userType"/>
          <cl:datacolumn comment="로그수집여부" std:sid="d-column-afecb947" name="isLogCollect" datatype="string"/>
        </cl:datacolumnlist>
      </cl:dataset>
      <cl:dataset comment="단말 로그" std:sid="d-set-30abd9c0" id="dsTerminal">
        <cl:datacolumnlist>
          <cl:datacolumn comment="사용자Id" std:sid="d-column-96f8a666" name="userId" datatype="string"/>
          <cl:datacolumn comment="사용자명" std:sid="d-column-05f193bc" name="userNm"/>
          <cl:datacolumn comment="화면명" std:sid="d-column-3becbe24" name="fileNm"/>
          <cl:datacolumn comment="화면ID" std:sid="d-column-6a12d088" name="appId"/>
          <cl:datacolumn comment="이벤트Type" std:sid="d-column-0c6618f3" name="eventType"/>
          <cl:datacolumn comment="타켓컨트롤" std:sid="d-column-2de58848" name="controlType" datatype="string"/>
          <cl:datacolumn comment="일자" std:sid="d-column-cd65626f" name="date"/>
        </cl:datacolumnlist>
      </cl:dataset>
      <cl:dataset comment="프로세스 목록" std:sid="d-set-406d885d" id="dsProcess">
        <cl:datacolumnlist>
          <cl:datacolumn std:sid="d-column-9f37779a" name="TITLE"/>
          <cl:datacolumn std:sid="d-column-05046705" name="TITLE_RIGHT_TEXT"/>
          <cl:datacolumn std:sid="d-column-7fe5300f" name="SUB_TITLE"/>
          <cl:datacolumn std:sid="d-column-c68cb733" name="DELIMITER" datatype="string"/>
          <cl:datacolumn std:sid="d-column-fa740970" name="CONT" datatype="string"/>
          <cl:datacolumn std:sid="d-column-c9d6a3d7" name="KEY_CODE"/>
          <cl:datacolumn std:sid="d-column-b4004ac2" name="SUB_CODE"/>
          <cl:datacolumn std:sid="d-column-8d6dc077" name="TARGET_CTRL"/>
          <cl:datacolumn std:sid="d-column-4e06ed8b" name="TARGET_EMB"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">목적</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">각 단말 별 접속 현황 확인 및 원격 LOG 파일 수집</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">검증 요소</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">다수 단말의 접속 현황 확인 및 모니터링 관리 기능 검증</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
            <cl:datavalue columnname="TARGET_EMB"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">특정 단말의 원격 LOG 파일 수집 및 모니터링 검증</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">측정</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">다수 단말의 접속 현황이 관리자 화면에서 정상적으로 표시되는지 확인</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">다수 단말의 접속 현황,관리자 화면</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
            <cl:datavalue columnname="TARGET_EMB"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">특정 단말의 원격 LOG 파일이 정상적으로 수집되고, 수집된 로그가 관리자 화면에서 확인 가능한지 확인</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">특정 단말의 원격 LOG 파일이 정상적으로 수집</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">수집된 로그가 관리자 화면에서 확인 가능</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">[접속 현황] 다양한 사용자로 로그인 후, 접속 현황 목록을 확인한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">[접속 현황]</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">접속 현황</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
            <cl:datavalue columnname="TARGET_EMB"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">[접속 현황] 강제로그아웃을 시킬 사용자를 체크한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">[접속 현황]</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">강제로그아웃</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">grd1</cl:datavalue>
            <cl:datavalue columnname="TARGET_EMB"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">[단말 로그] 일반 사용자는 1-2. 화면디자인 편집기 화면에서 다양한 이벤트를 수행한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">[단말 로그]</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">1-2. 화면디자인 편집기 화면</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
            <cl:datavalue columnname="TARGET_EMB"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">[단말 로그] 관리자는 LOG를 수집할 사용자의 로그수집 컬럼의 체크박스를 체크한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">[단말 로그]</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">로그수집</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">grd1</cl:datavalue>
            <cl:datavalue columnname="TARGET_EMB"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">[단말 로그] 로그수집 버튼을 클릭한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">[단말 로그]</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL">btn1</cl:datavalue>
            <cl:datavalue columnname="TARGET_EMB"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">[단말 로그] 사용자/화면별로 검색하여 LOG를 확인한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">[단말 로그]</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL">ipb2,ipb3</cl:datavalue>
            <cl:datavalue columnname="TARGET_EMB"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">eXBuilder6는 브라우저에서 발생하는 모든 이벤트를 추적/제어할 수 있는 글로벌 이벤트 핸들러를 제공하며 이를 통해 사용자 단말에서 발생한 이벤트 로그를 수집하고 중앙에서 통제할 수 있습니다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">글로벌 이벤트 핸들러를 제공</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">단말에서 발생한 이벤트 로그를 수집하고 중앙에서 통제</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
            <cl:datavalue columnname="TARGET_EMB"/>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
      <cl:submission std:sid="submission-fdbfa58e" id="subList" action="/websocket/list.do"/>
      <cl:submission std:sid="submission-bf3d909e" id="subOnLoad" action="/websocket/onLoad.do">
        <cl:responsedata dataid="dsConnectStatus"/>
        <cl:responsedata dataid="dsTerminal"/>
      </cl:submission>
    </cl:model>
    <cl:appspec title="관리자 전용 화면"/>
  </head>
