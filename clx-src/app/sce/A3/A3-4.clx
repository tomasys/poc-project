            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[(일반사용자) 기본 설정, 결재선을 선택한 후, 전송할 문서 내용을 입력한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[(일반사용자)]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[cmbDoc,ipbReceiver]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[(일반사용자) [승인 요청] 버튼을 클릭하여 일반사용자는 결재자에게 승인 요청을 전송한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[(일반사용자) ]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[btnReq]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[승인 요청]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[(결재자) 승인 요청 PUSH 알림 수신 여부를 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[(책임자)]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[PUSH]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[(결재자) [PUSH 서비스 지원 확인] 화면을 열고, 승인 요청 건 목록을 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[(책임자)]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[결재자 승인 확인,요청]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[grpContent]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[(결재자) 목록에서 요청 건을 선택하여, 승인 요청 내용 확인 후 [승인] 또는 [반려] 처리를 수행한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[(책임자)]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[승인,반려]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[btnApr,btnRej]]></cl:datavalue>
          </cl:datarow>
