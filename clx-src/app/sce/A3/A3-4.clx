            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[(일반사용자) 승인/반려 처리 결과에 대한 PUSH 알림 수신 여부를 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[(일반사용자)]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[PUSH]]></cl:datavalue>
