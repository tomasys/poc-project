            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[브라우저를 하나 더 오픈하여, 일반 사용자와 결재자로 로그인한 화면을 준비한다]]></cl:datavalue>
