        <cl:output std:sid="output-5953dfd4" id="opt199" class="txt" displayexp="&quot;eXBuilde6는 다양한 요건에 따라 입,출력 등의 기능을 제공하는 &quot; + sstr(&quot;기본 컴포넌트 38개&quot;, [&quot;fw-bold&quot;]) + &quot;와 화면을 구성하는 &quot; + sstr(&quot;레이아웃 5개&quot;, [&quot;fw-bold&quot;]) + &quot;를 지원하며,&quot; + &quot;\n\r&quot; + &quot;데이터를 구성하는 &quot;+ sstr(&quot;데이터 객체 3개&quot;, [&quot;fw-bold&quot;]) + &quot;와 통신 프로토콜 &quot; + sstr(&quot;서브미션 2개&quot;, [&quot;fw-bold&quot;]) + &quot;를 지원합니다.&quot; + &quot;\n\r&quot; + &quot;기본 컴포넌트를 포함하여 &quot; + sstr(&quot;총 48개&quot;, [&quot;fw-bold&quot;]) + &quot;의 컴포넌트를 지원합니다.&quot;&#xD;&#xA;+ &quot;\n\reXBuilde6는 &quot; + sstr(&quot;모바일 및 PC 전용 컨트롤을 구분하지 않고&quot;,[&quot;text-red&quot;,&quot;fw-bold&quot;]) + &quot; 모든 컨트롤은 동일한 환경에서 사용 가능합니다.&quot;">
          <cl:verticaldata std:sid="v-data-6574ec63" width="1218px" height="145px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-62f1ecf3" scrollable="false" spacing="8"/>
