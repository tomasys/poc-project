  <body std:sid="body-a0c207fd" class="wrap">
    <cl:listener std:sid="listener-1987da86" name="load" handler="onBodyLoad"/>
    <cl:listener std:sid="listener-717596f9" name="init" handler="onBodyInit"/>
    <cl:udc std:sid="ud-control-8c71e0ab" id="udcComAppHeader" type="udc.com.udcComAppHeader">
      <cl:verticaldata std:sid="v-data-d23e67ba" width="1238px" height="40px" autosize="height"/>
      <cl:property name="title" value="3.5 웹 에디터 기능 호환 및 지원" type="string"/>
      <cl:property name="isExpandAllPocProcess" value="true" type="boolean"/>
    </cl:udc>
    <cl:group std:sid="group-7e5559d4" id="grpGoverning" class="governing">
      <cl:verticaldata std:sid="v-data-ab3f2ba4" width="994px" height="130px" autosize="height"/>
      <cl:output std:sid="output-6fb83195" id="opt4" class="tit" value="웹 에디터">
        <cl:verticaldata std:sid="v-data-d68a450b" width="100px" height="28px" autosize="height"/>
      </cl:output>
      <cl:output std:sid="output-5953dfd4" id="opt5" class="txt" displayexp="&quot;eXBuilder6는 웹에디터(CK Editor5)를 제공하고 있으며, &quot; + sstr(&quot;외부 컴포넌트 연동 전용 컨트롤&quot;, [&quot;fw-bold&quot;]) + &quot;을 통해 오픈 아키텍처 및 상용 웹에디터와의 연동을 지원합니다.\n&quot;&#xD;&#xA;+&quot;이를 통해, eXBuilder6는&quot;+ sstr(&quot;표 삽입/편집 및 이미지/특수문자 삽입&quot;, [&quot;fw-bold&quot;]) + &quot;이 가능한 &quot; +sstr(&quot;다양한 에디터와의 호환성을 제공&quot;, [&quot;fw-bold&quot;]) + &quot;하고 있습니다.&quot;&#xD;&#xA;">
        <cl:verticaldata std:sid="v-data-6574ec63" width="1218px" height="60px" autosize="height"/>
      </cl:output>
      <cl:verticallayout std:sid="v-layout-62f1ecf3" scrollable="false" spacing="8"/>
    </cl:group>
    <cl:group std:sid="group-be39b9f1" id="grpData" class="conts-area">
      <cl:verticaldata std:sid="v-data-851ebd20" width="994px" height="1292px" autosize="height"/>
