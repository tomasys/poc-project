            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[임포트용 엑셀 파일 다운로드 버튼을 눌러 파일을 다운로드 받고 엑셀 임포트 버튼을 눌러 데이터를 불러온다.\n그리드 타이틀 우측의 엑셀 다운로드 아이콘을 눌러 엑셀을 익스포트한다.]]></cl:datavalue>
