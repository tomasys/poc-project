          <cl:datacolumn comment="연결할 화면 ID" std:sid="d-column-15da5a5b" name="src"/>
          <cl:datacolumn comment="프로세스 사용여부" std:sid="d-column-2fd5b55c" name="useYN"/>
          <cl:datacolumn comment="순서도 모양" std:sid="d-column-99a78fbe" name="shape" datatype="string"/>
        </cl:datacolumnlist>
        <cl:datarowlist/>
      </cl:dataset>
    </cl:model>
    <cl:appspec dev-comment="※ dsAddWorkFlow 의 선행 데이터 예시 &#xD;&#xA;   (아래 내용을 Copy&amp;Paste 하여 사용 할 수 있습니다)&#xD;&#xA;&#xD;&#xA;1&#x9;대상고객선정&#x9;app/sce/A3/A3-8-1&#x9;Y&#x9;rectangle&#xD;&#xA;&#x9;대상고객선정&#x9;&#x9;N&#x9;rectangle&#xD;&#xA;2&#x9;고객제외조건&#x9;app/sce/A3/A3-8-2&#x9;Y&#x9;rectangle&#xD;&#xA;3&#x9;캠페인일반정의&#x9;app/sce/A3/A3-8-1&#x9;Y&#x9;diamond&#xD;&#xA;4&#x9;성공조건등록&#x9;app/sce/A3/A3-8-2&#x9;Y&#x9;circle&#xD;&#xA;5&#x9;직원배분&#x9;app/sce/A3/A3-8-1&#x9;Y&#x9;hexagon&#xD;&#xA;6&#x9;캠페인실행&#x9;app/sce/A3/A3-8-2&#x9;Y&#x9;circle" title="워크플로우"/>
  </head>
