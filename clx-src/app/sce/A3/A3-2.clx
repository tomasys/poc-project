    <cl:group std:sid="group-7e5559d4" id="grpGoverning" class="governing">
      <cl:verticaldata std:sid="v-data-ab3f2ba4" width="994px" height="177px" syncminheight="false" autosize="height"/>
      <cl:output std:sid="output-6fb83195" id="opt4" class="tit" value="차트 기능 호환 및 지원">
        <cl:verticaldata std:sid="v-data-d68a450b" width="100px" height="28px" autosize="height"/>
      </cl:output>
      <cl:output std:sid="output-5953dfd4" id="opt5" class="txt" displayexp="&quot;eXBuilder6는 다양한 형태의 차트(eChart)를 제공하고 있으며, &quot; + sstr(&quot;외부 컴포넌트 연동 컨트롤&quot;, [&quot;fw-bold&quot;])+ &quot;을 통해 오픈 아키텍처 및 상용 차트와의 연동을 지원합니다.\n&quot;&#xD;&#xA;+&quot;이를 통해, &quot; + sstr(&quot;다양한 차트와의 호환성을 제공하며 이를 UDC로 제작 시, 기본 컨트롤처럼 사용이 가능합니다.&quot;, [&quot;fw-bold&quot;])&#xD;&#xA;">
        <cl:verticaldata std:sid="v-data-6574ec63" width="1218px" height="77px" autosize="height"/>
      </cl:output>
      <cl:output std:sid="output-dc84dc5e" id="opt2" style="color:blue; font-size:16px;" class="underline cursor-pointer" value="eChart">
        <cl:listener std:sid="listener-3669f73f" name="click" handler="onOpt2Click"/>
        <cl:verticaldata std:sid="v-data-e4d064dd" width="992px" height="20px" autosize="none"/>
      </cl:output>
      <cl:verticallayout std:sid="v-layout-62f1ecf3" scrollable="false" spacing="8"/>
    </cl:group>
    <cl:group std:sid="group-be39b9f1" id="grpData" class="conts-area">
      <cl:verticaldata std:sid="v-data-851ebd20" width="992px" height="1973px" autosize="height"/>
      <cl:group std:sid="group-a47f66c3" id="grp1" class="conts-wrap">
        <cl:verticaldata std:sid="v-data-53211d7f" width="992px" height="1973px" autosize="height"/>
        <cl:udc std:sid="ud-control-832e3ad2" id="udcComFormTitle1" type="udc.com.udcComFormTitle">
