          <cl:property name="fileUrl" value="data/docs/A2-3.png" type="resource"/>
        </cl:udc>
        <cl:formlayout std:sid="f-layout-de7d59fd" scrollable="false" hspace="0px" vspace="8px" top-margin="16px" right-margin="16px" bottom-margin="16px" left-margin="16px">
          <cl:rows length="1" unit="FRACTION"/>
          <cl:columns length="1" unit="FRACTION"/>
        </cl:formlayout>
