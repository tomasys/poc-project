    </cl:udc>
    <cl:group std:sid="group-be39b9f1" id="grpData" class="conts-area">
      <cl:formdata std:sid="f-data-dab623af" width="100" height="12" row="1" col="0"/>
      <cl:group std:sid="group-a47f66c3" id="grp23" class="governing">
        <cl:formdata std:sid="f-data-e0631aec" width="100" height="12" row="0" col="0"/>
        <cl:output std:sid="output-6eec988b" id="opt1" class="tit" value="HTML5 준수 및 Non-Active X">
          <cl:verticaldata std:sid="v-data-b432b5da" width="100px" height="28px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-bb84371e" id="grp24">
          <cl:verticaldata std:sid="v-data-ea93627d" width="400px" height="54px" autosize="height"/>
          <cl:output std:sid="output-1c257dfa" id="opt18" class="txt" displayexp="&quot;eXBuilder6는 W3C에서 제정된 &quot; + sstr(&quot;웹 표준을 준수한 UI 솔루션&quot;, [&quot;fw-bold&quot;]) + &quot;으로, 개발된 웹 어플리케이션은 &quot; + sstr(&quot;표준 HTML5를 지원&quot;, [&quot;fw-bold&quot;]) + &quot;합니다.&quot; + &quot;\n\r&quot;+ &quot;또한, 범용 &quot;+ sstr(&quot;웹 브라우저에서 ActiveX나 플러그인 등 별도의 설치없이 동일한 뷰(View)와 기능을 제공&quot;, [&quot;fw-bold&quot;]) + &quot;합니다.&quot;">
            <cl:verticaldata std:sid="v-data-e032687f" width="100px" height="48px" autosize="height"/>
          </cl:output>
          <cl:verticallayout std:sid="v-layout-f89b6ca4" scrollable="false" spacing="5"/>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-63c3bf60" scrollable="false" spacing="8" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
      </cl:group>
      <cl:group std:sid="group-77393ca7" class="conts-wrap">
