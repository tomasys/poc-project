          <cl:datacolumn std:sid="d-column-b4004ac2" name="SUB_CODE"/>
          <cl:datacolumn comment="" std:sid="d-column-8d6dc077" name="TARGET_CTRL"/>
          <cl:datacolumn std:sid="d-column-a2dba26f" name="column1"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">목적</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">1.1 시나리오(S1)의 화면이 사용자 O/S, 브라우저 환경에/n제약이 있는지 체크한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">검증 조건</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">1.1 시나리오(S1) 화면을 확인 한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">측정</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[다양한 OS 및 브라우저에서 UI 표현 및 컴포넌트가/n동일하게 동작하는지 체크한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE">다양한 OS 및 브라우저</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">•</cl:datavalue>
            <cl:datavalue columnname="CONT">스튜디오에서는 별도의 서버없이 미리보기 기능을 통해/n다양한 브라우저로 화면 확인 가능</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">1.1 시나리오(S1) 화면을 미리보기 기능으로/n다양한 브라우저에서 동작하는지 확인한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">시나리오(S1) 화면</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">미리보기</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">개발 스튜디오에서 1.1 시나리오(S1) UI 미리보기를 실행한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">스튜디오</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">미리보기</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec title="O/S, 브라우저 호환성"/>
