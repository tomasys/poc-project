            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[대용량 데이터 로딩시 빠른 성능 및 패킷을 절감하여 서버 부하를 줄이며 , GRID 에서 대용량 데이터를 원할히 조작 할 수 있어야 한다 .]]></cl:datavalue>
