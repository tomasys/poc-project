    <screen std:sid="screen-3e2be0b8" id="EXB-FULL" name="EXB-FULL" width="1024px" height="768px" useCustomWidth="false" useCustomHeight="true" customHeight="838" customWidth="800" active="true"/>
    <cl:model std:sid="model-d8305ae6">
      <cl:dataset comment="프로세스 목록" std:sid="d-set-406d885d" id="dsProcess">
        <cl:datacolumnlist>
          <cl:datacolumn comment="" std:sid="d-column-9f37779a" name="TITLE"/>
          <cl:datacolumn std:sid="d-column-3e5eca5d" name="TITLE_RIGHT_TEXT"/>
          <cl:datacolumn comment="" std:sid="d-column-7fe5300f" name="SUB_TITLE"/>
          <cl:datacolumn comment="" std:sid="d-column-c68cb733" name="DELIMITER" datatype="string"/>
          <cl:datacolumn comment="" std:sid="d-column-fa740970" name="CONT" datatype="string"/>
          <cl:datacolumn comment="" std:sid="d-column-c9d6a3d7" name="KEY_CODE"/>
          <cl:datacolumn std:sid="d-column-b4004ac2" name="SUB_CODE"/>
          <cl:datacolumn comment="" std:sid="d-column-8d6dc077" name="TARGET_CTRL"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">목적</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[P.41]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[화면 접근 통제 기능을 제공한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">검증 조건</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[반복적인 화면 접근 시도 및 화면 내 트랜잭션 요청 중 접근제한 등의 통제 실시간 적용 가능 여부]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[화면 접근통제 적용 시 즉각적으로 화면 접근 차단 및 내부 트랜잭션 수행 불가 여부]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[접근통제 후에는 추가 화면접근 뿐 아니라, 기존 열려있는 화면 내 트랜잭션 요청/수행 불가(이벤트가 동작하면 안됨)]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">측정</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[화면 접근 통제 페이지에서 일반 사용자에 대한 메뉴, 트랙잭션 허용 여부 값을 변경한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[열려있던 페이지가 즉각적으로 접근 차단되는 것을 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[접근 통제 후 페이지 접근 불가 및 트랜잭션 수행 불가한 것을 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[하나의 브라우저에서는 관리자 계정으로 로그인하고, 다른 브라우저에서는 일반사용자 계정으로 로그인한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[일반 사용자 계정 브라우저에서 시나리오 페이지를 들어간다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[관리자 계정 브라우저에서 일반 사용자가 연 페이지에 접근 권한을 삭제한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[접근 권한]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[삭제]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">•</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[일반 사용자 계정 브라우저에서 즉각적으로 접근 차단되며, 추가 화면접근이 되지 않는것을 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[접근 차단]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[즉각적으로]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">•</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[관리자 계정 브라우저에서 일반 사용자가 연 페이지에 트랜잭션 수행 권한을 삭제한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[트랜잭션 수행 권한]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[삭제]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[일반 사용자 계정 브라우저에서 트랜잭션을 수행하는 버튼들이 강제 비활성화 되며 트랜잭션 요청/수행을 할수없는 것을 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[트랜잭션 요청/수행]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[강제 비활성화]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
      <cl:dataset comment="메뉴" std:sid="d-set-a1e801ff" id="dsAllMenu" filtercondition="REFLECT_YN != &quot;N&quot; &amp;&amp; UP_MENU_ID != &quot;&quot; &amp;&amp; UP_MENU_ID != &quot;LEVEL00-00&quot;" staterestore="true">
        <cl:datacolumnlist>
          <cl:datacolumn comment="메뉴명" std:sid="d-column-b7d0e3e2" name="MENU_NM"/>
          <cl:datacolumn comment="메뉴 아이디" std:sid="d-column-1a75e7e3" name="MENU_ID"/>
          <cl:datacolumn std:sid="d-column-ce8bf8b8" name="UP_MENU_ID"/>
          <cl:datacolumn std:sid="d-column-18380ef4" name="TOP_MENU_ID"/>
          <cl:datacolumn comment="대상 페이지" std:sid="d-column-b7879d44" name="CALL_PAGE"/>
          <cl:datacolumn std:sid="d-column-9bdc2fe6" name="PGM_ID"/>
          <cl:datacolumn std:sid="d-column-4c100870" name="ICON"/>
          <cl:datacolumn std:sid="d-column-a2bd6f9f" name="MENU_KEY"/>
          <cl:datacolumn std:sid="d-column-1d8b7278" name="MOBILE_YN"/>
          <cl:datacolumn std:sid="d-column-7bb4293e" name="DESC"/>
          <cl:datacolumn std:sid="d-column-f1e3e1d7" name="CLASS"/>
          <cl:datacolumn std:sid="d-column-a5f7493c" name="MENU_DESC" datatype="expression" expression="&quot;[&quot; + MENU_NM + &quot;] &quot; + DESC&#xD;&#xA;"/>
          <cl:datacolumn std:sid="d-column-e7bfcd7b" name="MENU_LOWERCASE" datatype="expression" expression="doLowerCase(MENU_NM)"/>
          <cl:datacolumn std:sid="d-column-48c5ffc5" name="DESC_LOWERCASE" datatype="expression" expression="doLowerCase(DESC)"/>
          <cl:datacolumn std:sid="d-column-e9a2adee" name="MENU_LVL" datatype="number"/>
          <cl:datacolumn std:sid="d-column-833dbc36" name="MENU_FAV"/>
          <cl:datacolumn std:sid="d-column-f4a106b6" name="TAG"/>
          <cl:datacolumn std:sid="d-column-ce41a5d0" name="TAG_LOWERCASE" datatype="expression" expression="doLowerCase(TAG)"/>
          <cl:datacolumn std:sid="d-column-c02635f6" name="REFLECT_YN"/>
          <cl:datacolumn comment="일반사용자 메뉴 접근여부" std:sid="d-column-26a049e3" name="USR_ACCESS_YN"/>
          <cl:datacolumn comment="일반사용자 트랜잭션 허용여부" std:sid="d-column-9e70a736" name="USR_TRANS_YN"/>
          <cl:datacolumn std:sid="d-column-84fd9390" name="SORT_COL" datatype="number"/>
        </cl:datacolumnlist>
        <cl:datarowlist/>
      </cl:dataset>
    </cl:model>
    <cl:appspec dev-comment="templates/테스트케이스/테스트케이스_조회.clx 템플릿 사용하여 작성 함." title="화면 접근 통제 기능"/>
