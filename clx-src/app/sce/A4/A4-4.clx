          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[적용기술]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[엔진 경량화 및 외부 라이브러리 불포함]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[적용기술]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[서버 컴파일 방식이 아닌 사전 컴파일 방식 적용]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[적용기술]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[소스 압축 및 난독화 기능 제공]]></cl:datavalue>
