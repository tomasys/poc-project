          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[적용기술]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[화면에 보여지는 만큼만 처리하는 UI렌더링 방식으로, 복잡한 화면이나 대용량 처리에 일정수준의 성능 보장]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[적용기술]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[Virtual-DOM 메모리에 가상돔을 구성하여 실제돔과의 차이점을 비교해 변경된 부분만 DOM에 적용하는 기술]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[적용기술]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[(브라우저의 성능은 DOM을 생성, 업데이트, 삭제 시 많은 비용을 차지함)]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[]]></cl:datavalue>
