            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[[시나리오 S1 화면 호출] 버튼을 클릭하여 화면을 호출한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[시나리오 S1 화면 호출]]></cl:datavalue>
