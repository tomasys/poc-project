        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">목적</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[대용량 데이터 로딩시(48개 컬럼, 10만건) 빠른 성능 및 패킷을 절감하여 서버 부하를 줄이며 , GRID 에서 대용량 데이터를 원할히 조작 할 수 있어야 한다 .]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[48개 컬럼,10만건]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[화면 요구사항]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[1. 최대 10만건에 해당하는 데이터가 그리드에 표시되어야 한다. (페이지 처리 없이)]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[10만건]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[시나리오]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[2. 각 명칭 및 중공종 같은 구분값으로 소계와 전체 합계가 계산되어서 표시되어야 한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[소계,합계]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[시나리오]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[3. 엑셀파일을 통한 업로드 및 다운로드가 가능해야 한다. (10만건, 진행도 표시, 시스템 중지 없이)]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[진행도 표시]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[업로드,다운로드]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[4. 금액 및 선택값이 수정되어야 하고, 실시간으로 소계, 합계 금액에 반영되어야 한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[수정,반영]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[금액,소계,합계]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[시나리오]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[○]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[측정]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[시나리오]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[검증 화면을 실행한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[시나리오]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[처리 시간을 확인한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[10만건 데이터를 조회한다.\n(적용기술 : TSV 응답처리)]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[10만건]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[nbe3,btn1]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[공통코드 적용 컬럼 ⇒ 집행비목코드, 수량통제여부, 진행대상원가여부, 비목코드, 연면적여부]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[중공종, 공종 컬럼으로 구분된 실행예산 컬럼에서 각각 소계와 합계가 표시되는 것을 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[소계,합계]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[중공종,공종,실행예산]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[grdList]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[엑셀 다운로드를 진행 및 프로그레스바를 통한 진행도를 확인한다.\n(적용기술 : 웹워커)]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[다운로드]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[udcComGridTitle1]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[엑셀 업로드를 진행한다.\n(적용기술 : SAX Parser 핸들러)]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[업로드]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[fit1]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[각 단가 컬럼을 수정했을 때, 금액 및 소계, 합계 값이 실시간 반영되는지 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[금액,소계,합계,반영]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[fit1]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[단가]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">적용기술</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT"> 대용량 데이터 조회</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">적용기술</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">TSV(text/tab-separated-values) 응답 처리</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE">TSV</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">적용기술</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER"/>
            <cl:datavalue columnname="CONT">JSON,XML과 같은 데이터 통신보다 용량이 작으며, 로우 단위로 Streaming형식으로 분할된 데이터를 전송하는 대용량 데이터 통신 프로토콜</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">Streaming형식,분할</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">적용기술</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">IMPORT</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">적용기술</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">SAX Parser 핸들러</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE">SAX Parser 핸들러</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">적용기술</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER"/>
            <cl:datavalue columnname="CONT">압축된 OOXML형식의 엑셀을 메모리에 등록 후 순차적으로 데이터를 읽고, 읽은 데이터는 버퍼에서 flush하는 방식으로 대용량 엑셀 처리에 적합</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">압축된 OOXML형식</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">적용기술</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">EXPORT</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">적용기술</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">웹워커</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE">웹워커</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">적용기술</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER"/>
            <cl:datavalue columnname="CONT">스크립트 연산을 웹 어플리케이션의 주 실행 스레드와 분리된 별도의 백그라운드 스레드에서 실행할 수 있는 기술</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">별도의 백그라운드 스레드에서 실행할 수 있는 기술</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">적용기술</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER"/>
            <cl:datavalue columnname="CONT">웹 워커를 통해 무거운 작업을 분리된 스레드에서 처리하면 주 스레드(보통 UI 스레드)가 멈추거나 느려지지 않고 동작 가능</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">적용기술</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER"/>
            <cl:datavalue columnname="CONT">웹워커 통해 export를 위한 전체 데이터를 가공하지 않고, 별도의 멀티 스레드로 순차적으로 스트림하게 데이트를 가공하여 엑셀을 생성함으로 메모리 오버플로우 방지 및 안정성 제공</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">멀티 스레드로 순차적으로 스트림하게 데이트를 가공</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
      <cl:dataset std:sid="d-set-b961393e" id="dsList" info="PRJCT_CD, UP_CNSTKND_CD, CNSTKND_ID, CBGT_DTLS_ID">
        <cl:datacolumnlist>
          <cl:datacolumn comment="현장코드" std:sid="d-column-e07bbcf6" name="PRJCT_CD" datatype="string"/>
