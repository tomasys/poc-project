          <cl:datacolumn comment="" std:sid="d-column-96c2f4ad" name="KEY_CODE"/>
          <cl:datacolumn std:sid="d-column-8498462a" name="SUB_CODE"/>
          <cl:datacolumn comment="" std:sid="d-column-421ae73f" name="TARGET_CTRL"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">목적</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT">P.41</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">대용량 데이터 로딩시 빠른 성능 및 패킷을 절감하여 서버 부하를 줄이며 , GRID 에서 대용량 데이터를 원할히 조작 할 수 있어야 한다 .\n( 예 : 멀티소팅 , 열 변경 )</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">검증 조건</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">20 컬럼, 30 만건의 대량 더미 데이터를 처리한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">20 컬럼, 30 만건</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">솔루션 회사는 더미 데이터를 로딩하는 검증화면을 구현한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">데이터 건수 및 로딩 속도를 화면에 표출한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">측정</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">검증 화면을 실행하여 대량 데이터를 호출한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">측정 시간을 체크한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">패킷 사이즈를 측정한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">멀티 소팅이 되는지 확인한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">20개의 컬럼, 30 만건의 대용량 데이터를 조회한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">대용량 데이터를 조회</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">btn1</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">조회 시 데이터 건수와 로딩 속도가 화면에 시각적으로 표출되는지 확인한다.(스크롤 이동)</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">로딩 속도</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">데이터 건수,스크롤 이동</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">grpFrmOp</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">스크롤 이동시 브라우저 멈춤없이 빠른 속도로 렌더링 되는지 확인한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">브라우저 멈춤없이</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">•</cl:datavalue>
            <cl:datavalue columnname="CONT">대용량 데이터 전용 프로토콜인 TSV를 제공</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">TSV</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">•</cl:datavalue>
            <cl:datavalue columnname="CONT">JSON,XML과 같은 데이터 통신보다 용량이 작으며, 로우 단위로 Streaming형식으로 분할된 데이터를 전송하는 대용량 데이터 통신 프로토콜</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE">Streaming형식,분할</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">조회가 완료 된 후 최초 로드 시간과 처리시간을 확인한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">네트워크 시간,처리시간</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">udcGrdPrfCnt</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">그리드 헤더의 컬럼을 클릭하여 정렬을 확인한다. (멀티소팅)</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">멀티소팅</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">컬럼을 클릭하여 정렬</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">grdList</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">그리드 헤더의 컬럼을 드래그 &amp; 드롭하여 컬럼이동을 확인한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">컬럼이동</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">드래그,드롭</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">grdList</cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
