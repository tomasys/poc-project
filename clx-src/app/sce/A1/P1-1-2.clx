            <cl:attribute name="mobile-min-height" value="30"/>
            <cl:formdata std:sid="f-data-6b45f7c8" row="4" col="0"/>
          </cl:output>
          <cl:combobox std:sid="c-box-87b4bf49" id="cmb1" preventinput="true">
            <cl:attribute name="needs-auto-height" value="true"/>
            <cl:attribute name="mobile-min-height" value="30"/>
