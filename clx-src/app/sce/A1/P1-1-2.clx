            <cl:formdata std:sid="f-data-2011809f" row="4" col="1"/>
            <cl:item std:sid="t-item-e261d27c" label="LMS문구문의" value="LMS문구문의"/>
            <cl:item std:sid="t-item-20a9bc6d" label="결제금액문의" value="결제금액문의"/>
            <cl:item std:sid="t-item-0c55dbe0" label="결제일문의" value="결제일문의"/>
            <cl:item std:sid="t-item-f36f958b" label="계약문의" value="계약문의"/>
            <cl:item std:sid="t-item-d60d3c75" label="고객정보변경" value="고객정보변경"/>
            <cl:item std:sid="t-item-13885209" label="연락처변경" value="연락처변경"/>
          </cl:combobox>
          <cl:output std:sid="output-4417472d" id="opt7" class="label required" value="상담내용">
