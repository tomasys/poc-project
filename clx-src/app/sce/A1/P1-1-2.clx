            <cl:attribute name="mobile-min-height" value="30"/>
            <cl:formdata std:sid="f-data-fc2c4312" row="0" col="0"/>
          </cl:output>
          <cl:dateinput std:sid="d-input-4bbdc630" id="dti1" mask="YYYY.MM.DD HH:mm:ss" format="YYYY.MM.DD HH:mm:ss">
            <cl:attribute name="needs-auto-height" value="true"/>
            <cl:attribute name="mobile-min-height" value="30"/>
            <cl:datamapbind property="value" datacontrolid="DM_COUNSEL" columnname="CONS_DT"/>
