          <cl:datacolumn comment="종료일자" std:sid="d-column-9a8bf000" name="SAL_ED_DT"/>
          <cl:datacolumn comment="특약코드" std:sid="d-column-4aa7b0e6" name="SP_CTRT_CD"/>
          <cl:datacolumn comment="특약명" std:sid="d-column-efb21a2e" name="SP_CTRT_NM"/>
          <cl:datacolumn comment="특약시작일자" std:sid="d-column-802edba8" name="SP_CTRT_ST_DT"/>
          <cl:datacolumn comment="특약종료일" std:sid="d-column-4522309b" name="SP_CTRT_ED_DT"/>
