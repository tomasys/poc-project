    <cl:model std:sid="model-6f349bd4">
      <cl:dataset comment="프로세스 목록" std:sid="d-set-406d885d" id="dsProcess">
        <cl:datacolumnlist>
          <cl:datacolumn comment="" std:sid="d-column-9f37779a" name="TITLE"/>
          <cl:datacolumn std:sid="d-column-b4fe0e75" name="TITLE_RIGHT_TEXT"/>
          <cl:datacolumn comment="" std:sid="d-column-7fe5300f" name="SUB_TITLE"/>
          <cl:datacolumn comment="" std:sid="d-column-c68cb733" name="DELIMITER" datatype="string"/>
          <cl:datacolumn comment="" std:sid="d-column-fa740970" name="CONT" datatype="string"/>
          <cl:datacolumn comment="" std:sid="d-column-c9d6a3d7" name="KEY_CODE"/>
          <cl:datacolumn std:sid="d-column-b4004ac2" name="SUB_CODE"/>
          <cl:datacolumn comment="" std:sid="d-column-8d6dc077" name="TARGET_CTRL"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">목적</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">시나리오3(S3)의 구현된 내용이 정상적으로 표시되는지 확인한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">검증 조건</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">시나리오3(S3)의 기능을 확인한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">측정</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">진행 항목에 따라 기능을 검증한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">화면 Open시, 오늘 날짜 기준 판매중인 상품 리스트를 조회한다.</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">cmbPrdt</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">상품 리스트</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">오늘</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">선택한 상품에 대한 주계약 리스트를 조회한다.</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">cmbSpPrdt</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="KEY_CODE">주계약</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="CONT">(특약코드에서 &quot;A&quot; 와 &quot;P&quot;로 시작)</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">선택한 주계약에 대한 특약 리스트를 조회한다.</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">grd1</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">특약</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="CONT">(특약코드에서 &quot;X&quot;로 시작)</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">특약 분류 및 특약명 등의 검색으로 특약 리스트를 조회한다.</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">grpSearch</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">특약분류, 특약명</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="CONT">(특약분류에 따라 가장 위쪽 정렬, 특약명은 필터 검색 진행)</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">정렬,필터</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">추가 기능 점검</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="DELIMITER"/>
            <cl:datavalue columnname="CONT">1) 멀티창/멀티탭 기능 여부</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[	1-1) 멀티창: MultiTab+ 클릭]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">MultiTab+</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[btn2]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[	1-2) 멀티탭: Multi+ 클릭]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">Multi+</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[btn1]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="CONT">Multi+ 버튼 클릭 시 상품 및 특약 화면을 브라우저에 멀티(최대갯수)로 띄울 수 있다. 동일한 화면 띄워서 값 비교 (멀티 세션)</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[btn1]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[⇒]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="CONT">멀티창에서 메인창과 서브창의 글씨를 다르게 표현</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[btn1]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[⇒]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="DELIMITER"/>
            <cl:datavalue columnname="CONT">2) 접기/펼치기 (아코디언 구조 가능 여부)</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">tab1</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="DELIMITER"/>
            <cl:datavalue columnname="CONT">3) GRID 에서 필드 트리구조 가능 여부</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">grd1,trecell1</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="DELIMITER"/>
            <cl:datavalue columnname="CONT">4) GRID 필드 콤보박스 가능 여부</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">cmb2</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="DELIMITER"/>
            <cl:datavalue columnname="CONT">5) GRID 체크 일괄적용/ GRID에서 텍스트 금액 입력 시 일괄 변경 기능 여부</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">grd1,trecell1,nbe1</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="CONT">6) GRID 더블클릭 시 이벤트 가능 여부 및 팝업창 호출 가능 여부</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">grd1</cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
      <cl:dataset comment="상품및특약" std:sid="d-set-77a7d7cf" id="DS_PRDT_LIST" sortcondition="" filtercondition="@validateProduct(SAL_ST_DT, SAL_ED_DT)">
        <cl:datacolumnlist>
