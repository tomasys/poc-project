        <cl:dataview comment="주계약 리스트" std:sid="d-view-4924c9f1" id="dv1" filtercondition="PRD_CD == #cmbPrdt.value &amp;&amp; (SP_CTRT_CD ^= &quot;A&quot; || SP_CTRT_CD ^= &quot;P&quot;) &amp;&amp; @validateProduct(SP_CTRT_ST_DT, SP_CTRT_ED_DT) &amp;&amp; PRD_CD != &quot;&quot;"/>
        <cl:dataview comment="특약 리스트" std:sid="d-view-2e82c81b" id="dv2" sortcondition="DIV_TYPE DESC" filtercondition="PRD_CD == #cmbPrdt.value &amp;&amp; SP_CTRT_CD ^= &quot;X&quot; &amp;&amp; @validateProduct(SP_CTRT_ST_DT, SP_CTRT_ED_DT)"/>
