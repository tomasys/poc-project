          <cl:verticaldata std:sid="v-data-d68a450b" width="100px" height="33px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-5953dfd4" id="opt19" class="txt" displayexp="&quot;eXBuilder6는 &quot; + sstr(&quot;CSS에서 작성한 애니메이션을 자유롭게 적용 가능&quot;, [&quot;fw-bold&quot;]) + &quot;합니다.&quot;+ &quot;\r\n&quot; + &quot;이를 통해, &quot; + sstr(&quot;다양한 애니메이션을 실행하여 사용자 경험(UX)을 향상&quot;, [&quot;fw-bold&quot;]) + &quot;시키고, &quot; + sstr(&quot;콘텐츠를 효과적으로 전달&quot;, [&quot;fw-bold&quot;]) + &quot;할 수 있습니다.&quot; ">
          <cl:verticaldata std:sid="v-data-6574ec63" width="1218px" height="83px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-62f1ecf3" scrollable="false" spacing="8"/>
      </cl:group>
