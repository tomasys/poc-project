      <cl:output std:sid="output-6fb83195" id="opt18" class="tit" value="데이터 시각화 차트 및, 데이터 즉각 연동">
        <cl:verticaldata std:sid="v-data-d68a450b" width="100px" height="33px" autosize="height"/>
      </cl:output>
      <cl:output std:sid="output-5953dfd4" id="opt19" class="txt" displayexp="&quot;eXBuilder6는 &quot; + sstr(&quot;다양한 형태의 차트&quot;, [&quot;fw-bold&quot;])+&quot;(eChart)를 제공하고 있으며, &quot; + sstr(&quot;외부 컴포넌트 연동 전용 컨트롤인 Shell을&quot;, [&quot;fw-bold&quot;]) + &quot; 통해 오픈 아키텍처 및 상용 차트와의 연동을 지원합니다.&quot;+ &quot;\r\n&quot;&#xD;&#xA;+&quot;이를 통해, &quot;+ sstr(&quot;다양한 차트와의 호환성을 제공&quot;, [&quot;fw-bold&quot;]) + &quot;하며 이를 UDC로 제작 시, &quot; + sstr(&quot;기본 컨트롤처럼 사용이 가능&quot;, [&quot;fw-bold&quot;]) + &quot;합니다.&quot;">
        <cl:verticaldata std:sid="v-data-6574ec63" width="1218px" height="83px" autosize="height"/>
      </cl:output>
      <cl:verticallayout std:sid="v-layout-62f1ecf3" scrollable="false" spacing="8"/>
    </cl:group>
