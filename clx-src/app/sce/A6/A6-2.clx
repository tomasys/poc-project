    <cl:group std:sid="group-de3af362" class="conts-area">
      <cl:verticaldata std:sid="v-data-f9fd49fd" width="1592px" height="1178px" autosize="height"/>
      <cl:group std:sid="group-7e5559d4" id="grpGoverning" class="governing">
        <cl:verticaldata std:sid="v-data-fd78c9a4" width="992px" height="164px" autosize="height"/>
        <cl:output std:sid="output-6fb83195" id="opt18" class="tit" value="반응형 디자인">
          <cl:verticaldata std:sid="v-data-d68a450b" width="100px" height="33px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-5953dfd4" id="opt19" class="txt" displayexp="&quot;사용자 화면에 맞춰 UI컨트롤의 배치 자동변경 및 텍스트가 줄바꿈되는 &quot;+sstr(&quot;반응형 웹 특화 전용 레이아웃&quot;, [&quot;font-bold&quot;])+&quot;을 기본 제공하여, 한개의 화면 소스로 다양한 해상도에 최적화 된 UI를 제공합니다.\n&quot;&#xD;&#xA;+&quot;이를 통해 반응형 웹 화면 개발 시 &quot;+sstr(&quot;생산성은 향상&quot;, [&quot;font-bold&quot;])+&quot;되며,  해당도별 관리 포인트를 절감하여 &quot;+sstr(&quot;운영 효율성 또한 향상&quot;, [&quot;font-bold&quot;])+&quot;됩니다.&quot;">
          <cl:verticaldata std:sid="v-data-6574ec63" width="1218px" height="89px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-62f1ecf3" scrollable="false" spacing="8"/>
      </cl:group>
      <cl:group std:sid="group-0c8cb92a" class="conts-area">
