        <cl:group std:sid="group-55f35a4d">
          <std:metadata>
            <std:property key="locked" value="true"/>
          </std:metadata>
          <cl:output std:sid="output-b27dfd02" value="당사 콘텐츠는 개별종목에 대한 추천이 아니며 투자판단의 최종 책임은 고객 본인에게 있습니다. 어떠한 경우에도 콘텐츠에서 제공되는 내용이 고객의 투자 결과에 대한 법적 책임소재의 증빙자료로 사용할 수 없습니다">
            <cl:verticaldata std:sid="v-data-4fd5de5b" width="100px" height="20px" autosize="height"/>
          </cl:output>
          <cl:verticallayout std:sid="v-layout-d5d11c2f"/>
