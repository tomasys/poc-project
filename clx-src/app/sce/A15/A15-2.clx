            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[예약 설정 및 수정 버튼을 통해 날짜 지정 팝업이 호출된다.]]></cl:datavalue>
