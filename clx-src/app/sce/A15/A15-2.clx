            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[글쓰기 버튼 클릭시 편집 페이지로 이동한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[글쓰기]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[btnEdit]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[타이틀 클릭시 편집 화면으로 들어가서 값을 수정할 수 있다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[타이틀 클릭시]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[값을 수정]]></cl:datavalue>
