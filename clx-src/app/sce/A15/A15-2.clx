          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[공개 토글]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[편집 페이지에서 저장시 토글 off 상태로 리스트에 등록되며, 토글 on으로 변경 시 채널에 즉시 컨텐츠가 공개되어야 한다.]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[토글]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[예약이 걸려있는 상태에서는 토글이 비활성화 되어야한다.]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[비활성화]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
