        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">목적</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">REST API 또는 GraphQL 등의 데이터 API 명세 연동</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">검증 조건</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">서비스 API 통합 기능 시연</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">측정</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[시나리오]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[스튜디오의 서브미션(통신 프로토콜)에서 지원하는/n서비스 API를 호출하여 연동을 확인한다.]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[API 연동에 따라 자동으로 구성되는 데이터 객체를 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[서브미션 컨트롤의 Submission Builder 기능을 활용하여/nAPI 명세조회 및 API를 자동 생성한다.]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">Submission Builder,API 명세조회</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
            <cl:datavalue columnname="KEY_CODE">자동 생성</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[생성된 서브미션의 요청, 응답 정보 및 데이터 객체를 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[요청, 응답 정보,데이터 객체]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[매트릭스 서브미션 컨트롤의 Matrix Builder 기능을 활용하여/nAPI 명세조회 및 API를 자동 생성한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">자동 생성</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">Matrix Builder,API 명세조회</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[생성된 매트릭스 서브미션의 요청, 응답 정보 및 데이터 객체를 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[요청, 응답 정보,데이터 객체]]></cl:datavalue>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
      <cl:submission comment="서브미션" std:sid="submission-36e52370" id="sub" method="post" action="">
        <cl:attribute name="hello" value="world"/>
      </cl:submission>
      <cl:matrix-submission comment="매트릭스 서브미션" std:sid="m-submission-1eb9f83b" id="msub" async="true" withCredentials="false" method="post" action="">
        <cl:attribute name="hello" value="world"/>
        <cl:attribute name="itfNm" value="개인고객조회"/>
        <cl:attribute name="itfId" value="ICMPRSNCUSTMGMTPSI002R"/>
