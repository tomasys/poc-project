          <cl:verticaldata std:sid="v-data-30dd0d40" width="800px" height="28px" autosize="height"/>
          <cl:property name="title" value="서비스 API 통합 기능 제공(전문플러그인)" type="string"/>
        </cl:udc>
        <cl:output std:sid="output-1c257dfa" id="opt2" displayexp="&quot;eXBuilder6는 REST API와 같이 체계화된 &quot; + sstr(&quot;서비스 API 명세&quot;, [&quot;fw-bold&quot;]) + &quot;를 연동하여&quot; + &quot;정의된 API 명세에 따라 &quot; + sstr(&quot;서브미션(통신 프로토콜)&quot;, [&quot;fw-bold&quot;]) + &quot;을 자동 구성합니다.&quot;&#xD;&#xA;+ &quot;\n\r&quot; + &quot;자동구성된 서브미션과 더불어 연결된 &quot; + sstr(&quot;데이터 객체&quot;, [&quot;fw-bold&quot;]) + &quot; 또한 자동생성 및 바인딩하여 제공합니다.&quot;">
          <cl:verticaldata std:sid="v-data-a6e01c7f" width="1218px" height="48px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-94eb003e" scrollable="false" spacing="8"/>
      </cl:group>
