        </cl:output>
        <cl:output std:sid="output-5953dfd4" id="opt3" class="txt" displayexp="&quot;eXBuilder6는 &quot; + sstr(&quot;리포트 솔루션 연동&quot;, [&quot;fw-bold&quot;]) + &quot;을 위해, 임베디드 페이지, 쉘 등 특수 컨트롤을 제공하며 &quot; + sstr(&quot;OZ, Clip, Crownix, Ubi&quot;, [&quot;fw-bold&quot;]) + &quot;등 HTML5 기반의 모든 리포트 솔루션 연동을 지원합니다.&quot;&#xD;&#xA;">
          <cl:verticaldata std:sid="v-data-6574ec63" width="1218px" height="59px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-62f1ecf3" scrollable="false" spacing="8"/>
      </cl:group>
