          <cl:property name="title" value="One Source Multi Use 지원" type="string"/>
        </cl:udc>
        <cl:output std:sid="output-1c257dfa" id="opt2" class="txt" displayexp="&quot;eXBuilder6는 변경되는 사용자 해상도에 따라 &quot; + sstr(&quot;UI 컨트롤의 배치가 자동으로 변경&quot;, [&quot;fw-bold&quot;]) + &quot;되고, &quot;+ sstr(&quot;텍스트가 줄바꿈&quot;, [&quot;fw-bold&quot;]) + &quot;되는 &quot; + sstr(&quot;반응형 전용 레이아웃을 기본 제공&quot;, [&quot;fw-bold&quot;]) + &quot;하며,&quot; +&quot;\n\r&quot; + &quot;한 개의 화면 소스로 &quot; + sstr(&quot;다양한 해상도에 최적화&quot;, [&quot;fw-bold&quot;]) + &quot; 된 UI를 지원합니다. eXBuilder6는 가장 진화된 One Soucre Multi Use를 지원하는 유일한 UI솔루션 입니다.&quot; ">
          <cl:verticaldata std:sid="v-data-a6e01c7f" width="1218px" height="48px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-63c3bf60" scrollable="false" spacing="8"/>
      </cl:group>
