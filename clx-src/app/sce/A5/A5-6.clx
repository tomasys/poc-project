    <cl:udc std:sid="ud-control-8c71e0ab" id="udcComAppHeader" type="udc.com.udcComAppHeader">
      <cl:formdata std:sid="f-data-5e51d127" row="0" col="0"/>
      <cl:property name="title" value="5.6 코드 생성" type="string"/>
      <cl:property name="isExpandAllPocProcess" value="true" type="boolean"/>
    </cl:udc>
    <cl:group std:sid="group-be39b9f1" id="grpData" class="conts-area">
      <cl:formdata std:sid="f-data-aa52609e" width="100" height="67" row="1" col="0"/>
      <cl:group std:sid="group-7e5559d4" id="grpGoverning" class="governing">
        <cl:formdata std:sid="f-data-4f4cb84a" width="100" height="67" row="0" col="0"/>
        <cl:output std:sid="output-6fb83195" id="opt2" class="tit" value="코드 생성 기능">
          <cl:verticaldata std:sid="v-data-d68a450b" width="100px" height="28px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-5953dfd4" id="opt3" class="txt" value="`" displayexp="&quot;eXBuilder6는 &quot; + sstr(&quot;WYSIWYG 기반의 디자인 편집기&quot;, [&quot;fw-bold&quot;]) + &quot;를 통해, 스튜디오에서 위지윅하게 구성된 &quot; + sstr(&quot;UI&quot;, [&quot;fw-bold&quot;]) + &quot;를 즉시 &quot; + sstr(&quot;소스코드로 생성&quot;, [&quot;fw-bold&quot;]) + &quot;하여 제공합니다.&quot; + &quot;\n\r&quot; + &quot;또한 스튜디오 내 &quot;+ sstr(&quot;컴파일된 결과보기&quot;, [&quot;fw-bold&quot;]) + &quot;를 통해 변환된 소스를 확인 할 수 있으며, 이를 통해 쉽게 동적 컴포넌트 개발을 할 수 있는 환경을 제공합니다.&quot;&#xD;&#xA;">
          <cl:verticaldata std:sid="v-data-6574ec63" width="1218px" height="61px" autosize="height"/>
        </cl:output>
        <cl:group std:sid="group-539eda60" id="grp2">
          <cl:verticaldata std:sid="v-data-339aa009" width="1208px" height="28px" autosize="none"/>
          <cl:button std:sid="button-f98ac746" id="btnCreateCode" value="코드 생성">
            <cl:listener std:sid="listener-192d9fdf" name="click" handler="onBtnCreateCodeClick"/>
            <cl:formdata std:sid="f-data-0c5349ea" row="0" col="0"/>
          </cl:button>
          <cl:formlayout std:sid="f-layout-0bb7cb6e" scrollable="false" hspace="4px" vspace="4px" top-margin="0px" right-margin="0px" bottom-margin="0px" left-margin="0px">
