          <cl:verticaldata std:sid="v-data-3fab2d1f" width="100px" height="36px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-8ee29a77" class="txt" value="" displayexp="&quot;eXBuilder6는 직관적인 화면 디자인 편집기를 통해 UI 컴포넌트를 쉽고 빠르게 배치하고, 트리 구조로 구성 요소를 한눈에 확인할 수 있습니다. 페이지별 템플릿과 팝업·모달·모달리스 기능을 지원하여 &quot; + sstr(&quot;다양한 화면을 효율적으로 제작할 수 있습니다.&quot;, [&quot;fw-bold&quot;])">
          <cl:verticaldata std:sid="v-data-5be08e2e" width="100px" height="114px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-da8b67ae" scrollable="false" spacing="16"/>
      </cl:group>
      <cl:group std:sid="group-30b83fb0">
        <cl:verticaldata std:sid="v-data-aea21f1b" width="976px" height="1810px" autosize="height"/>
        <cl:embeddedapp std:sid="e-app-825d4665" src="A5-9-1.clx">
          <cl:verticaldata std:sid="v-data-967ce0a3" width="320px" height="1810px" autosize="height"/>
        </cl:embeddedapp>
        <cl:verticallayout std:sid="v-layout-dcd69873" spacing="8" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-ce4764db" spacing="16"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-6c29c5cc" scrollable="true" spacing="16" leftmargin="24" rightmargin="24" topmargin="16" bottommargin="24"/>
