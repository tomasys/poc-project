          <cl:output std:sid="output-1c257dfa" id="opt18" displayexp="&quot;eXBuilder6는 &quot; + sstr(&quot;Full WYSIWYG 기반의 강력한 디자인 편집기&quot;, [&quot;fw-bold&quot;]) + &quot;를 통해, &quot; + sstr(&quot;쉽고 직관적인 화면 구성방식을 제공&quot;, [&quot;fw-bold&quot;]) + &quot;합니다.&quot; + &quot;\n\r&quot; +&quot;전문 퍼블리셔가 필요 없을 정도로 쉽고 간편한 화면 구성방식은 &quot; + sstr(&quot;퍼블리싱 공수를 획기적으로 절감&quot;, [&quot;fw-bold&quot;]) + &quot;시켜주며, &quot; + sstr(&quot;개발 생산성&quot;, [&quot;fw-bold&quot;]) + &quot; 뿐 아니라, &quot; + sstr(&quot;유지보수의 용이성&quot;, [&quot;fw-bold&quot;]) + &quot; 또한 향상됩니다.&quot;&#xD;&#xA;">
            <cl:verticaldata std:sid="v-data-e032687f" width="1218px" height="77px" autosize="height"/>
          </cl:output>
          <cl:verticallayout std:sid="v-layout-f89b6ca4" scrollable="false"/>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-63c3bf60" scrollable="false" spacing="8" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
      </cl:group>
