            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[eXBuilder6 파일을 화면 설계서로 생성한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[eXBuilder6 파일]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[생성된 개발산출물(화면 설계서)을/n확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">개발산출물</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">기타</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">설계서 문서 포멧 변경가능(엑셀양식)</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">기타</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">설계서에 정의된 항목은 eXBuilder6의 컴포넌트 및 이벤트에 약속된 포멧으로 작성 필요</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">기타</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">EXPORT방식은 HTML, EXCEL만 가능</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
