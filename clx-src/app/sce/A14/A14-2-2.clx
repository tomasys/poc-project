            <cl:datavalue columnname="CONT">목적</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT">P.61</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">테스트 자동화 기능 확인</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">스튜디오 시연</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">자동 테스트 버튼을 클릭하여/n자동 테스트를 실행한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">자동 테스트</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL">btnAutoTest</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">자동 테스트가 완료된 후/n테스트 로그 뷰어를 확인한다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE">테스트 로그 뷰어</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">예상 테스트 결과 성공:5, 실패:1(상품)</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE">테스트 로그 뷰어</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">기타</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">eXBuilder6 미리보기서버내 로봇제어 기능</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">기타</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">시나리오는 eXBuilder6 문법만 이해하면 작성 가능</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">기타</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[일반적인 로봇은 모니터의 좌표기준으로 실행되나 eXBuilder6의 로봇테스트는 이벤트가 발생되는 컴포넌트의 ID 기준으로 실행]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[컴포넌트의 ID]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">기타</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">브라우저 런타임 환경에서 테스트가 가능하므로 junit의 목(Mock)객체 생성을 위한 별도의 작업 및 비용 필요 없음</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE"/>
            <cl:datavalue columnname="TARGET_CTRL"/>
          </cl:datarow>
        </cl:datarowlist>
