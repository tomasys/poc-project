      <cl:formdata std:sid="f-data-587751bf" width="100" height="47" row="1" col="0"/>
      <cl:group std:sid="group-30e895ac" id="grp3" class="governing">
        <cl:formdata std:sid="f-data-e2077e23" width="100" height="47" row="0" col="0"/>
        <cl:output std:sid="output-786b3990" id="opt3" class="txt" displayexp="&quot;eXBuilder6는 URL 노출 방지를 위해, &quot; + sstr(&quot;임베디드 앱&quot;, [&quot;fw-bold&quot;]) + &quot; 컨트롤과 &quot; + sstr(&quot;MDI 폴더&quot;, [&quot;fw-bold&quot;]) + &quot; 등 SPA(Single Page Web Application) 아키텍처의 구현을 위한 다양한 인프라를 지원합니다.&quot; +&quot;\n\r&quot; +&quot;이를 통해, &quot;+ sstr(&quot;URL 노출 및 변경 없이 다양한 페이지를 탭 형태로 쉽게 접근&quot;, [&quot;fw-bold&quot;]) + &quot;할 수 있습니다.&quot;">
          <cl:verticaldata std:sid="v-data-6e8e7c0b" width="1218px" height="48px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-5f33f841" scrollable="false" spacing="8"/>
      </cl:group>
