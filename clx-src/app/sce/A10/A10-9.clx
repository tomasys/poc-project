      <cl:property name="isExpandAllPocProcess" value="true" type="boolean"/>
    </cl:udc>
    <cl:group std:sid="group-1ccc36fb" id="grpData" class="conts-area">
      <cl:verticaldata std:sid="v-data-f8850c33" width="976px" height="230px" autosize="height"/>
      <cl:group std:sid="group-a47f66c3" id="grpGoverning" class="governing">
        <cl:verticaldata std:sid="v-data-f14172f0" width="992px" height="153px" autosize="height"/>
        <cl:output std:sid="output-6fb83195" id="opt1" class="tit" value="웹 보안 기능 지원">
          <cl:verticaldata std:sid="v-data-d68a450b" width="100px" height="36px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-1c257dfa" id="opt2" class="txt" displayexp="&quot;eXBuilder6는 &quot; + sstr(&quot;로그인 세션 관리기능&quot;, [&quot;fw-bold&quot;])+ &quot;을 응용 제공하며, 최적의 웹 보안 구축을 지원합니다.\n&quot;&#xD;&#xA;+ &quot;이를 통해 안전한 인증 환경을 구축하여 &quot; + sstr(&quot;사용자 정보 보호&quot;, [&quot;fw-bold&quot;]) + &quot;와 &quot; +  sstr(&quot;편리한 접근 제어&quot;, [&quot;fw-bold&quot;])+&quot;를 동시에 지원합니다.\n&quot;&#xD;&#xA;">
          <cl:verticaldata std:sid="v-data-6574ec63" width="1218px" height="67px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-63c3bf60" scrollable="false" spacing="8"/>
      </cl:group>
      <cl:group std:sid="group-f64b214d" class="conts-wrap">
        <cl:verticaldata std:sid="v-data-5aaf6449" width="976px" height="50px" autosize="height"/>
        <cl:group std:sid="group-539eda60" id="grp5" class="border-base">
          <cl:verticaldata std:sid="v-data-ca8bb892" width="950px" height="28px" autosize="height"/>
          <cl:radiobutton std:sid="r-button-e57ce84a" id="rdbDuplLogin" value="Y" hspacing="4">
            <cl:listener std:sid="listener-5099e189" name="selection-change" handler="onRdb1SelectionChange"/>
            <cl:flowlayoutdata std:sid="f-data-c9b47a27" width="391px" height="28px" autosize="width"/>
            <cl:item std:sid="item-a9f5fd50" label="중복 로그인 허용" value="Y"/>
            <cl:item std:sid="item-d88eb07a" label="중복 로그인 미허용" value="N"/>
          </cl:radiobutton>
          <cl:button std:sid="button-2c8e243d" id="btn1" value="로그인 세션 시간 변경">
            <cl:listener std:sid="listener-ccdbf47f" name="click" handler="onBtn1Click"/>
            <cl:flowlayoutdata std:sid="f-data-b8f23bc2" width="224px" height="28px" autosize="width"/>
          </cl:button>
          <cl:button std:sid="button-5b2f1457" id="btn2" value="로그인 세션 시간 연장">
            <cl:listener std:sid="listener-6ff60110" name="click" handler="onBtn2Click"/>
            <cl:flowlayoutdata std:sid="f-data-4cb88a38" width="198px" height="28px" autosize="width"/>
          </cl:button>
          <cl:flowlayout std:sid="f-layout-09fd5208" hspacing="4" vspacing="4"/>
        </cl:group>
        <cl:verticallayout std:sid="v-layout-0aa23698" spacing="8" leftmargin="16" rightmargin="16" topmargin="16" bottommargin="16"/>
      </cl:group>
      <cl:verticallayout std:sid="v-layout-39b9f8f8" spacing="16"/>
    </cl:group>
    <cl:verticallayout std:sid="v-layout-2c8811a3" spacing="16" leftmargin="24" rightmargin="24" topmargin="16" bottommargin="24"/>
