    <cl:group std:sid="group-be39b9f1" id="grpData" class="conts-area">
      <cl:verticaldata std:sid="v-data-6edc15a8" width="992px" height="715px" autosize="height"/>
      <cl:group std:sid="group-a47f66c3" class="governing">
        <cl:formdata std:sid="f-data-4264599b" row="0" col="0"/>
        <cl:output std:sid="output-c688e879" class="tit" value="리스소 암호화 검증">
          <cl:verticaldata std:sid="v-data-1c5a7046" width="100px" height="28px" autosize="height"/>
        </cl:output>
        <cl:output std:sid="output-1c257dfa" class="txt" value="devtools-detector.js 라이브러리는 브라우저 개발자 도구(DevTools)의 열림 여부를 감지하는 데 사용됩니다. &#xD;&#xA;이 기능을 통해 웹 리소스(예: JavaScript 코드, 민감한 데이터 등)에 대한 보안 또는 무결성 검사를 강화하거나, 디버깅 시도를 차단하는 방어 로직을 구성할 수 있습니다.">
          <cl:verticaldata std:sid="v-data-8090fffc" width="1218px" height="43px" autosize="height"/>
        </cl:output>
        <cl:verticallayout std:sid="v-layout-63c3bf60" scrollable="false" spacing="8" leftmargin="0" rightmargin="0" topmargin="0" bottommargin="0"/>
      </cl:group>
      <cl:group std:sid="group-fbcac4bd" class="conts-wrap">
        <cl:formdata std:sid="f-data-a7b9750f" width="100" height="4" row="1" col="0"/>
        <cl:group std:sid="group-b906e537" class="form">
          <cl:attribute name="table-min-height" value=""/>
          <cl:attribute name="mobile-column-count" value="1"/>
          <cl:attribute name="tablet-column-count" value="2"/>
          <cl:verticaldata std:sid="v-data-0eb71d99" width="992px" height="91px" autosize="height"/>
          <cl:output std:sid="output-030bb1ec" class="label" value="개발자 도구 탐지">
            <cl:formdata std:sid="f-data-3c414c95" row="0" col="0"/>
          </cl:output>
          <cl:group std:sid="group-eb30de9f">
            <cl:formdata std:sid="f-data-fa0c0be7" row="0" col="1" rowspan="1" colspan="1"/>
            <cl:button std:sid="button-0111bcf7" value="시작">
              <cl:listener std:sid="listener-cc79ef1d" name="click" handler="onBtn1Click"/>
              <cl:flowlayoutdata std:sid="f-data-42453f89" width="70px" height="28px"/>
            </cl:button>
            <cl:button std:sid="button-fd121a6a" value="종료">
              <cl:listener std:sid="listener-0986e99c" name="click" handler="onBtnStart2Click"/>
