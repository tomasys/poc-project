            <cl:listener std:sid="listener-27d21675" name="selection-change" handler="onRdbCrashSelectionChange"/>
            <cl:formdata std:sid="f-data-67ec32c4" row="1" col="1"/>
            <cl:item std:sid="item-d8e19e41" label="화면 새로고침" value="reload"/>
            <cl:item std:sid="item-068c07d1" label="화면 작동 중단" value="crash"/>
          </cl:radiobutton>
          <cl:formlayout std:sid="f-layout-d1049485" scrollable="false" hspace="16px" vspace="17px" top-margin="8px" right-margin="8px" bottom-margin="8px" left-margin="8px" hseparatorwidth="1" hseparatortype="BY_CLASS">
            <cl:rows length="28" unit="PIXEL"/>
            <cl:rows length="28" unit="PIXEL"/>
            <cl:columns length="270" unit="PIXEL" autoSizing="true" hidden="false" shadetype="BY_CLASS" syncminlength="false"/>
            <cl:columns length="1" unit="FRACTION"/>
