          <cl:datacolumn comment="" std:sid="d-column-8d6dc077" name="TARGET_CTRL"/>
          <cl:datacolumn std:sid="d-column-49173c65" name="TARGET_EMB"/>
        </cl:datacolumnlist>
        <cl:datarowlist>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">목적</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">단말UI를 통해 저장되는 각종 파일의 암호화를 통한 보안 강화</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">검증 요소</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">스크립트를 제외한 화면 모든 리소스 암호화 검증</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">측정</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">　</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">리소스 암호화 검증 확인</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">암호화</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">리소스</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">　</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[(오픈소스 기능) [리소스 암호화] devtools-detector.js 라이브러리를 활용하여 리소스 파일 확인을 사전에 차단할 수 있는지 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">[리소스 암호화] </cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">　</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL">btnStart</cl:datavalue>
            <cl:datavalue columnname="TARGET_EMB">embapp1</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="CONT">웹은 본질적으로 오픈 환경이므로 브라우저에서 렌더링되는 리소스는 결국 사용자가 추출할 수 있습니다.또한 모든 정적 파일의 암호화와 복호화 과정을 브라우저에서 수행하면 성능 문제를 초래할 수 있습니다.따라서 SSL 및 TLS를 적용하고, 리소스 접근을 제어하기 위해 개발자 도구 사용을 제한하는 것이 바람직합니다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"/>
            <cl:datavalue columnname="SUB_CODE">오픈 환경, 성능 문제를 초래, 개발자 도구 사용을 제한</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
            <cl:datavalue columnname="TARGET_EMB"/>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec title="리소스 암호화"/>
  </head>
