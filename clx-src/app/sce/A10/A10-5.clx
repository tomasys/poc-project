        <cl:output std:sid="output-1c257dfa" id="opt2" class="txt" displayexp="&quot;eXBuilder6는 &quot; + sstr(&quot;스튜디오 내 간단한 옵션 설정&quot;, [&quot;fw-bold&quot;]) + &quot;을 통해 개발된 &quot; + sstr(&quot;화면 소스의 압축 및 난독화 기능을 사용&quot;, [&quot;fw-bold&quot;]) + &quot;할 수 있습니다.&quot; + &quot;\n\r&quot;+ &quot;이를 통해, &quot; + sstr(&quot;보안성 및 성능&quot;, [&quot;fw-bold&quot;]) + &quot;향상을 지원합니다.&quot;">
