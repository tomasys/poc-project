            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT">목적</cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[각 단말 별 접속 현황 확인 및 원격 LOG 파일 수집]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[시나리오]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[○]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[검증 요소]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[시나리오]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[다수 단말의 접속 현황 확인 및 모니터링 관리 기능 검증]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_EMB"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[시나리오]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[특정 단말의 원격 LOG 파일 수집 및 모니터링 검증]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">○</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[측정]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[시나리오]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[다수 단말의 접속 현황이 관리자 화면에서 정상적으로 표시되는지 확인]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[다수 단말의 접속 현황,관리자 화면]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_EMB"><![CDATA[]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">시나리오</cl:datavalue>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[특정 단말의 원격 LOG 파일이 정상적으로 수집되고, 수집된 로그가 관리자 화면에서 확인 가능한지 확인]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[특정 단말의 원격 LOG 파일이 정상적으로 수집]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[수집된 로그가 관리자 화면에서 확인 가능]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[(모든 검증요소 - 솔루션 기능) ]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[[접속 현황] 강제로그아웃을 시킬 사용자를 체크한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[[접속 현황]]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[강제로그아웃]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[grd1]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_EMB"><![CDATA[embAdmin]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[[단말 로그] 일반 사용자는 1-2. 화면디자인 편집기 화면에서 다양한 이벤트를 수행한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[[단말 로그]]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[1-2. 화면디자인 편집기 화면]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_EMB"><![CDATA[embAdmin]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[[단말 로그] 관리자는 LOG를 수집할 사용자의 로그수집 컬럼의 체크박스를 체크한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[[단말 로그]]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[로그수집]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[grd1]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_EMB"><![CDATA[embAdmin]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[[단말 로그] 로그수집 버튼을 클릭한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[[단말 로그]]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[btn1]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_EMB"><![CDATA[embAdmin]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE"><![CDATA[진행]]></cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="SUB_TITLE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="DELIMITER"><![CDATA[-]]></cl:datavalue>
            <cl:datavalue columnname="CONT"><![CDATA[[단말 로그] 사용자/화면별로 검색하여 LOG를 확인한다.]]></cl:datavalue>
            <cl:datavalue columnname="KEY_CODE"><![CDATA[[단말 로그]]]></cl:datavalue>
            <cl:datavalue columnname="SUB_CODE"><![CDATA[]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"><![CDATA[ipb2,ipb3]]></cl:datavalue>
            <cl:datavalue columnname="TARGET_EMB"><![CDATA[embAdmin]]></cl:datavalue>
          </cl:datarow>
          <cl:datarow>
            <cl:datavalue columnname="TITLE">진행</cl:datavalue>
            <cl:datavalue columnname="TITLE_RIGHT_TEXT"/>
            <cl:datavalue columnname="SUB_TITLE"/>
            <cl:datavalue columnname="DELIMITER">-</cl:datavalue>
            <cl:datavalue columnname="CONT">eXBuilder6는 브라우저에서 발생하는 모든 이벤트를 추적/제어할 수 있는 글로벌 이벤트 핸들러를 제공하며 이를 통해 사용자 단말에서 발생한 이벤트 로그를 수집하고 중앙에서 통제할 수 있습니다.</cl:datavalue>
            <cl:datavalue columnname="KEY_CODE">글로벌 이벤트 핸들러를 제공</cl:datavalue>
            <cl:datavalue columnname="SUB_CODE">단말에서 발생한 이벤트 로그를 수집하고 중앙에서 통제</cl:datavalue>
            <cl:datavalue columnname="TARGET_CTRL"/>
            <cl:datavalue columnname="TARGET_EMB"/>
          </cl:datarow>
        </cl:datarowlist>
      </cl:dataset>
    </cl:model>
    <cl:appspec title="모니터링"/>
