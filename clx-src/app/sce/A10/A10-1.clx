    <cl:group std:sid="group-e12078bb" id="grpGoverning" class="governing">
      <cl:verticaldata std:sid="v-data-5ac79574" width="992px" height="188px" autosize="height"/>
      <cl:output std:sid="output-6fb83195" id="opt7" class="tit" value="보안 지원, XSS, CSRF 방어 등 보안 기능 내장">
        <cl:verticaldata std:sid="v-data-d68a450b" width="100px" height="28px" autosize="height"/>
      </cl:output>
      <cl:output std:sid="output-1c257dfa" id="opt8" class="txt" displayexp="&quot;eXBuilder6는 데이터 통신시 &quot; + sstr(&quot;제품 자체 스펙으로 입력값 필터, 이스케이프 처리를 지원하여&quot;, [&quot;fw-bold&quot;]) +&quot;, 서버로 전송되는 데이터를 정제할 수 있으며,\n&quot;&#xD;&#xA;+&quot;응답값을 받을 때엔 &quot; + sstr(&quot;html의 innerHTML에 직접 삽입하지 않고 html 요소의 textContent로 값을 소비&quot;, [&quot;fw-bold&quot;]) +&quot;하기 때문에 서버에서 XSS 공격을 가정한 값이 넘어와도 안전한 통신을 지원합니다.\n\n&quot;&#xD;&#xA;+&quot;클라이언트에서 CSRF 방어를 위해서  &quot; + sstr(&quot;CSRF-TOKEN 정보를 서비스 요청 헤더에 추가&quot;, [&quot;fw-bold&quot;]) +&quot;하여 토큰값이 일치하는 경우에만 서비스를 허용하는 정책을 구현할 수 있습니다.&quot;">
        <cl:verticaldata std:sid="v-data-6b2bb3ae" width="1218px" height="118px" autosize="height"/>
      </cl:output>
      <cl:verticallayout std:sid="v-layout-a5bd7b9e" scrollable="false" spacing="8"/>
    </cl:group>
    <cl:group std:sid="group-66084879" id="grpData" class="conts-area">
      <cl:verticaldata std:sid="v-data-dae4d285" width="976px" height="564px" autosize="height"/>
