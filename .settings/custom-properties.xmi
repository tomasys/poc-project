    <controlProperties name="editablePK" label="유효성 검사/editablePK" desc="PK컬럼 수정 가능 여부">
      <predefinedValues>Y</predefinedValues>
    </controlProperties>
    <controlProperties name="autoKeydownSearch" label="조회 영역 초기화/autoKeydownSearch" desc="Enter 키 입력 시, 조회 버튼 click 이벤트 발생&#xD;&#xA;ignoreInit=Y 인 조회 영역은 적용 불가">
      <predefinedValues>Y</predefinedValues>
    </controlProperties>
    <controlProperties name="compare" label="유효성 검사/compare" desc="상대 값 비교&#xD;&#xA;• 그리드 일경우: columnName,비교연산자(&lt;=, &lt;, >=, >, ==, =)&#xD;&#xA;• 일반 컨트롤일 경우: 컨트롤 ID,비교연산자(&lt;=, &lt;, >=, >, ==, =)"/>
    <controlProperties name="fixedDecimal" label="유효성 검사/fixedDecimal" desc="정수와 소수 영역의 각 최대 자리 수 체크&#xD;&#xA;• valueType: Number,Number&#xD;&#xA;ex. 3,2(정수 최대 3자리, 소수 최대 2자리 유효, 0 ~ 999.99)"/>
    <controlProperties name="maxDecimalPointLength" label="유효성 검사/maxDecimalPointLength" desc="소수점 영역 최대 자리 수 체크&#xD;&#xA;• valueType: Number, ex.3"/>
    <controlProperties name="minDecimalPointLength" label="유효성 검사/minDecimalPointLength" desc="소수점 영역 최소 자리 수 체크&#xD;&#xA;• valueType: Number, ex.3"/>
    <controlProperties name="integer" label="유효성 검사/integer" desc="정수 타입에 따라 value 가 유효한 값인지 체크&#xD;&#xA;- small : short integer&#xD;&#xA;- normal : integer&#xD;&#xA;- big : long integer">
      <predefinedValues>small</predefinedValues>
      <predefinedValues>normal</predefinedValues>
      <predefinedValues>big</predefinedValues>
    </controlProperties>
    <controlProperties name="integer-between" label="유효성 검사/integer-between" desc="value가 특정 정수 값 사이에 있는지 체크&#xD;&#xA;콤마(,) 로 연결하여 최소,최대값 을 작성하십시오.&#xD;&#xA;• valueType: Number, ex.3,5"/>
    <controlProperties name="maxLengthDigits" label="유효성 검사/maxLengthDigits" desc="value 의 최대 길이 체크&#xD;&#xA;• valueType: Number, ex.3"/>
    <controlProperties name="min" label="유효성 검사/min" desc="value 가 최소 값보다 작은지 체크&#xD;&#xA;• valueType: Number, ex.100"/>
    <controlProperties name="max" label="유효성 검사/max" desc="value 가 최대 값보다 큰지 체크&#xD;&#xA;• valueType: Number, ex.100"/>
  </settings:CustomProperties>
