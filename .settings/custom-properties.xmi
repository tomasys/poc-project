<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:settings="kr.co.tomatosystem.exbuilder.model.ui.settings">
  <settings:CustomProperties type="All">
    <controlProperties name="needs-auto-height" label="반응형/폼 레이아웃/needs-auto-height" desc="자동높이 사용 여부">
      <predefinedValues>true</predefinedValues>
    </controlProperties>
    <controlProperties name="hide-on-tablet" label="반응형/공통/hide-on-tablet" desc="• 폼 레이아웃 : 태블릿 환경에서 숨겨질 자식 컨트롤.&#xA;(폼 레이아웃 자식 컨트롤의 사용자 속성에 지정)&#xA;&#xA;• 버티컬 레이아웃 : 태블릿 환경에서 버티컬 레이아웃 숨김여부">
      <predefinedValues>true</predefinedValues>
    </controlProperties>
    <controlProperties name="hide-on-mobile" desc="• 폼 레이아웃 : 모바일 환경에서 숨겨질 자식 컨트롤.&#xA;(폼 레이아웃 자식 컨트롤의 사용자 속성에 지정)&#xA;&#xA;• 버티컬 레이아웃 : 모바일 환경에서 버티컬 레이아웃 숨김여부">
      <predefinedValues>true</predefinedValues>
    </controlProperties>
    <controlProperties name="w-class" desc="PC 클래스명"/>
    <controlProperties name="t-class" desc="Tablet 클래스명"/>
    <controlProperties name="m-class" desc="Mobile 클래스명"/>
    <controlProperties name="needs-auto-width" label="반응형/폼 레이아웃/needs-auto-width" desc="자동너비 사용 여부">
      <predefinedValues>true</predefinedValues>
    </controlProperties>
    <controlProperties name="tablet-min-width" label="반응형/폼 레이아웃/tablet-min-width" desc=""/>
    <controlProperties name="mobile-min-width" label="반응형/폼 레이아웃/mobile-min-width" desc=""/>
  </settings:CustomProperties>
