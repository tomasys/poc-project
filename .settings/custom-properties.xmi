      <predefinedValues>Y</predefinedValues>
    </controlProperties>
    <controlProperties name="compare" label="유효성 검사/compare" desc="상대 값 비교&#xD;&#xA;• 그리드 일경우: columnName,비교연산자(&lt;=, &lt;, >=, >, ==, =)&#xD;&#xA;• 일반 컨트롤일 경우: 컨트롤 ID,비교연산자(&lt;=, &lt;, >=, >, ==, =)"/>
    <controlProperties name="between" label="유효성 검사/between" desc="날짜 비교, 두 날짜 사이에 있는지 체크&#xD;&#xA;기준 날짜는 포함되지 않는다.&#xD;&#xA;• valueType: String[], ex. 20230101,20231231"/>
  </settings:CustomProperties>
  <settings:CustomProperties type="EmbeddedApp"/>
  <settings:CustomProperties type="EmbeddedPage"/>
  <settings:CustomProperties type="FileInput">
    <controlProperties name="required" label="유효성 검사/required" desc="필수 값 지정 여부">
