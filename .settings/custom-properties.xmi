      <predefinedValues>Y</predefinedValues>
    </controlProperties>
    <controlProperties name="autoKeydownSearch" label="조회 영역 초기화/autoKeydownSearch" desc="Enter 키 입력 시, 조회 버튼 click 이벤트 발생&#xD;&#xA;ignoreInit=Y 인 조회 영역은 적용 불가">
      <predefinedValues>Y</predefinedValues>
    </controlProperties>
    <controlProperties name="columnType" label="유효성 검사/columnType" desc="컨트롤 value 에 대한 타입 체크&#xD;&#xA;· email: 이메일&#xD;&#xA;· ssn: 주민번호&#xD;&#xA;· bizno: 사업자번호&#xD;&#xA;· phone: 핸드폰 번호&#xD;&#xA;· tel: 유선 전화번호&#xD;&#xA;· url: URL 주소&#xD;&#xA;· frno: 외국인등록번호&#xD;&#xA;· corp: 법인번호&#xD;&#xA;· credit: 카드 번호&#xD;&#xA;· zipcd: 우편번호">
      <predefinedValues>email</predefinedValues>
      <predefinedValues>ssn</predefinedValues>
      <predefinedValues>bizno</predefinedValues>
      <predefinedValues>phone</predefinedValues>
      <predefinedValues>tel</predefinedValues>
      <predefinedValues>url</predefinedValues>
      <predefinedValues>frno</predefinedValues>
      <predefinedValues>corp</predefinedValues>
      <predefinedValues>credit</predefinedValues>
      <predefinedValues>zipcd</predefinedValues>
    </controlProperties>
    <controlProperties name="mergeControlIds" label="유효성 검사/mergeControlIds" desc="컨트롤 value 에 대한 타입 체크 시, 체크 할 value가 여러 개의 컨트롤에 분리되어 있는 경우, 함께 체크할 컨트롤 ID&#xD;&#xA;※ 자기 자신은 제외하며, value 를 합칠 ID 를 순서대로 콤마(,) 연결하여 작성"/>
    <controlProperties name="minlength" label="유효성 검사/minlength" desc="컨트롤 value의 최소 길이 체크&#xD;&#xA;• valueType: Number, ex. 10"/>
    <controlProperties name="fixlength" label="유효성 검사/fixlength" desc="컨트롤 value 의 고정 길이 체크&#xD;&#xA;• valueType: Number, ex. 10"/>
    <controlProperties name="maxlength" label="유효성 검사/maxlength" desc="컨트롤 value의 최대 길이 체크&#xD;&#xA;• valueType: Number, ex. 10"/>
  </settings:CustomProperties>
