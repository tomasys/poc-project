    <controlProperties name="mobile-vertical-margin" label="반응형/폼레이아웃/mobile-vertical-margin" desc=""/>
    <controlProperties name="mobile-h-spacing" label="반응형/폼레이아웃/mobile-h-spacing" desc=""/>
    <controlProperties name="mobile-v-spacing" label="반응형/폼레이아웃/mobile-v-spacing" desc=""/>
    <controlProperties name="mobile-index" label="반응형/폼레이아웃/mobile-index" desc=""/>
    <controlProperties name="tablet-index" label="반응형/폼레이아웃/tablet-index" desc=""/>
  </settings:CustomProperties>
  <settings:CustomProperties type="Grid">
    <controlProperties name="transform-on-mobile" label="반응형/그리드/transform-on-mobile" desc="모바일 환경에서 반응형 그리드 적용 여부">
      <predefinedValues>accordionType</predefinedValues>
      <predefinedValues>dialogType</predefinedValues>
      <predefinedValues>list</predefinedValues>
      <predefinedValues>massiveList</predefinedValues>
    </controlProperties>
    <controlProperties name="view-column-indicies" label="반응형/그리드/view-column-indicies" desc="반응형 그리드 적용 시, 표시할 colIndex&#xD;&#xA;• valueType: Number[], ex.1,3,4"/>
    <controlProperties name="ignoreModify" label="유효성 검사/ignoreModify" desc="그리드 변경사항 체크를 제외 할 지 여부">
      <predefinedValues>Y</predefinedValues>
    </controlProperties>
    <controlProperties name="ignoreInit" label="그리드 초기화/ignoreInit" desc="그리드 초기화 제외 여부">
      <predefinedValues>Y</predefinedValues>
    </controlProperties>
    <controlProperties name="bindDataFormId" label="그리드 초기화/bindDataFormId" desc="선택 행 컨텍스트 바인딩으로 연결된 그룹 ID&#xD;&#xA;• valueType: String, ex. grpForm"/>
    <controlProperties name="applyGridSortable" label="그리드 초기화/applyGridSortable" desc="헤더 컬럼 sortable 값을 사용자가 설정한 값으로 적용할지 여부&#xD;&#xA;미작성 시 sortable=true 로 설정된다">
      <predefinedValues>Y</predefinedValues>
    </controlProperties>
    <controlProperties name="applyGridFilterable" label="그리드 초기화/applyGridFilterable" desc="헤더 컬럼 filterable 값을 사용자가 설정한 값으로 적용할지 여부&#xD;&#xA;미작성 시 filterable=true 로 설정된다">
      <predefinedValues>Y</predefinedValues>
    </controlProperties>
    <controlProperties name="selectAfterLoad" label="그리드 초기화/selectAfterLoad" desc="데이터 셋 load 시, 그리드의 첫 번째 행 또는 마지막 작업 행을 선택 할 지 여부.&#xD;&#xA;N일 경우 행은 선택되지 않는다.">
      <predefinedValues>N</predefinedValues>
    </controlProperties>
  </settings:CustomProperties>
  <settings:CustomProperties type="Group">
    <controlProperties name="ignoreModify" label="유효성 검사/ignoreModify" desc="선택 행 컨텍스트 바인딩으로 연결된 그룹인 경우&#xD;&#xA;그룹에 바인딩 된 데이터 셋의 변경사항 체크를 제외할지 여부">
      <predefinedValues>Y</predefinedValues>
    </controlProperties>
    <controlProperties name="ignoreInit" label="조회 영역 초기화/ignoreInit" desc="조회 영역 초기화 제외 여부">
      <predefinedValues>Y</predefinedValues>
    </controlProperties>
    <controlProperties name="tablet-column-count" label="반응형/폼 레이아웃/tablet-column-count" desc="태블릿 환경에서 폼 레이아웃의 Row에 보여줄 컬럼 수&#xD;&#xA;• valueType : Number, ex. 2"/>
    <controlProperties name="mobile-column-count" label="반응형/폼 레이아웃/mobile-column-count" desc="모바일 환경에서 폼 레이아웃의 Row에 보여줄 컬럼 수&#xD;&#xA;• valueType : Number, ex. 2"/>
    <controlProperties name="tablet-min-height" label="반응형/폼 레이아웃/tablet-min-height" desc="테블릿일 경우 폼 레이아웃의 최소 높이"/>
    <controlProperties name="mobile-min-height" label="반응형/폼 레이아웃/mobile-min-height" desc="모바일일 경우 폼 레이아웃의 최소 높이"/>
    <controlProperties name="mustValidate" label="유효성 검사/mustValidate" desc="그룹의 visible=false 로 인해 보이지 않는 자식 컨트롤에 대한 유효성 검사를 진행할지 여부 (Y로 설정 할 경우, 무조건 유효성 검사 수행)">
      <predefinedValues>Y</predefinedValues>
    </controlProperties>
    <controlProperties name="tablet-fit" label="반응형/버티컬 레이아웃/tablet-fit" desc="태블릿 환경에서 반응형 버티컬 레이아웃 사용 여부">
      <predefinedValues>true</predefinedValues>
    </controlProperties>
    <controlProperties name="mobile-fit" label="반응형/버티컬 레이아웃/mobile-fit" desc="모바일 환경에서 반응형 버티컬 레이아웃 사용 여부">
      <predefinedValues>true</predefinedValues>
    </controlProperties>
  </settings:CustomProperties>
  <settings:CustomProperties type="HTMLObject"/>
