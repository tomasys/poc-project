    <controlProperties name="tablet-align" label="반응형/플로우레이아웃/tablet-align" desc="">
      <predefinedValues>left</predefinedValues>
      <predefinedValues>center</predefinedValues>
      <predefinedValues>right</predefinedValues>
    </controlProperties>
    <controlProperties name="tablet-min-width" label="반응형/플로우레이아웃/tablet-min-width" desc=""/>
    <controlProperties name="tablet-min-height" label="반응형/플로우레이아웃/tablet-min-height" desc=""/>
  </settings:CustomProperties>
  <settings:CustomProperties type="FormLayout">
    <controlProperties name="tablet-horizontal-margin" label="반응형/폼레이아웃/tablet-horizontal-margin" desc=""/>
    <controlProperties name="tablet-vertical-margin" label="반응형/폼레이아웃/tablet-vertical-margin" desc=""/>
