new-file-templates=<?xml version\="1.0" encoding\="UTF-8" standalone\="no"?><templates><template autoinsert\="false" context\="nsk.newfile" deleted\="false" description\="\uC0C8 CLX \uD30C\uC77C\uC758 \uC2A4\uD06C\uB9BD\uD2B8 \uD15C\uD50C\uB9BF" enabled\="true" name\="nsk.newfile.clx.js">/************************************************\r\n * ${filename}\r\n * @\uD504\uB85C\uADF8\uB7A8\uC124\uBA85 \: \r\n *\r\n * @\uC791\uC131\uC77C\uC790 \:  ${date}.\r\n * @\uC791\uC131\uC790 \: ${user}\r\n *\r\n * @\uC218\uC815\uC774\uB825 \: \uC218\uC815\uC77C\uC790 (\uC218\uC815\uC790) \uC218\uC815\uB0B4\uC6A9\r\n ************************************************/\r\n \r\n/************************************************\r\n ** \uAE00\uB85C\uBC8C \uBCC0\uC218, \uC0C1\uC218\uBCC0\uC218\r\n ************************************************/ \r\n\r\n\r\n/************************************************\r\n ** \uAE00\uB85C\uBC8C \uD568\uC218\r\n ************************************************/ \r\n\r\n\r\n/************************************************\r\n ** \uD30C\uC77C\uB0B4 \uB85C\uCEEC\uBCC0\uC218 \uC120\uC5B8  \r\n ************************************************/ \r\nvar util \= createCommonUtil();\r\n\r\n/************************************************\r\n ** \uC0AC\uC6A9\uC790 \uC815\uC758 \uC790\uBC14\uC2A4\uD06C\uB9BD\uD2B8 \uD568\uC218\uB97C \uAE30\uC220 \r\n ************************************************/ \r\n/**\r\n * \uCD5C\uCD08 \uD654\uBA74 \uB85C\uB4DC \uC2DC \uD638\uCD9C\uB418\uB294 \uD568\uC218\r\n */\r\nfunction doOnLoad () {\r\n\t\r\n}\r\n\r\n/**\r\n * \uC870\uD68C \uC2DC \uD638\uCD9C\uB418\uB294 \uD568\uC218\r\n */\r\nfunction doList () {\r\n\t\r\n}\r\n\r\n/**\r\n * \uC800\uC7A5 \uC2DC \uD638\uCD9C\uB418\uB294 \uD568\uC218\r\n */\r\nfunction doSave () {\r\n\t\r\n}\r\n\r\n/************************************************\r\n ** \uC790\uB3D9\uC73C\uB85C \uC0DD\uC131\uB418\uB294 \uC774\uBCA4\uD2B8 \uC790\uBC14\uC2A4\uD06C\uB9BD\uD2B8 \uD568\uC218\uB97C \uBC30\uCE58\r\n ** (\uC774\uBCA4\uD2B8 \uC0DD\uC131\uC2DC \uC790\uB3D9\uC73C\uB85C \uC2A4\uD06C\uB9BD\uD2B8 \uD568\uC218 \uD558\uC704\uC5D0 \uD45C\uC2DC) \r\n ************************************************/</template></templates>
script.user-project-new-file-templates=true
templates=<?xml version\="1.0" encoding\="UTF-8" standalone\="no"?><templates><template autoinsert\="true" context\="nsk.code" deleted\="false" description\="\uACF5\uD1B5\uC11C\uBE0C\uBBF8\uC158" enabled\="true" name\="send">util.Submit.send(app, "", function(pbSuccess){&\#13;\r\n\tif(pbSuccess){&\#13;\r\n\t\t\t\t&\#13;\r\n\t}&\#13;\r\n});</template><template autoinsert\="true" context\="nsk.code" deleted\="false" description\="\uACF5\uD1B5 \uB2E4\uC774\uC5BC\uB85C\uADF8 alert" enabled\="true" name\="alert">util.Msg.alertDlg(app, "");</template><template autoinsert\="true" context\="nsk.code" deleted\="false" description\="\uACF5\uD1B5 \uB2E4\uC774\uC5BC\uB85C\uADF8 \uC624\uD508" enabled\="true" name\="open">util.Dialog.open(app, "", width, height, function(e) {\t\t&\#13;\r\n\t\t/** @type cpr.controls.Dialog */&\#13;\r\n\t\tvar dialog \= e.control;&\#13;\r\n\t\t&\#13;\r\n\t\t/* \uD31D\uC5C5 close \uD6C4 \uCC98\uB9AC \uB3D9\uC791*/\t&\#13;\r\n\t\tvar returnValue \= dialog.returnValue; // \uD31D\uC5C5\uC5D0\uC11C \uC804\uB2EC\uD55C retrunValue&\#13;\r\n\t\t&\#13;\r\n\t\tif (returnValue) {&\#13;\r\n\t\t\t&\#13;\r\n\t\t}\t&\#13;\r\n});</template><template autoinsert\="true" context\="nsk.code" deleted\="false" description\="\uC720\uD6A8\uC131 \uAC80\uC0AC" enabled\="true" name\="validate">if(\!util.validate(app, "")) return;</template><template autoinsert\="true" context\="nsk.code" deleted\="false" description\="\uACF5\uD1B5 \uB2E4\uC774\uC5BC\uB85C\uADF8 confirm" enabled\="true" name\="confirm">util.Msg.confirmDlg(app, "");</template><template autoinsert\="true" context\="nsk.code" deleted\="false" description\="\uACF5\uD1B5 \uB2E4\uC774\uC5BC\uB85C\uADF8 notify" enabled\="true" name\="notify">util.Msg.notify(app, "");</template></templates>
